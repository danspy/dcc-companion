# Nothing is required to render the companion — the content ships in the repo.

# The achievements page asks a model to write in the System's voice, and that
# is the only thing here that needs a key. Without it the page still renders;
# filing a report answers "*** Transmission interrupted ***" instead.
# OpenRouter is preferred when its key is set: https://openrouter.ai/keys
# Gemma 4 31B, free pool first, the paid copy of the same model behind it.
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-31b-it

# Ollama Cloud (no free tier since 2026-11): used only without an OpenRouter key.
OLLAMA_API_KEY=

# Optional. Defaults to gpt-oss:120b, and to Ollama Cloud's endpoint — point
# OLLAMA_HOST at http://127.0.0.1:11434 to use a local daemon instead.
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_HOST=https://ollama.com

# Reserved for a later accounts phase:
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin12345
