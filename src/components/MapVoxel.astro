---
/* A floor's map in voxels (src/lib/voxel/maps/): the scene built from the
   layers the reader has reached, as one pixel-art image, with numbered
   callouts and a mask per layer so the page can light a feature and dim the
   rest. Same classes as the highlighting script and styles expect. */
import type { MapLayer } from '../lib/floormap';
import { mapScene } from '../lib/voxel/mapscene';
import { placeCallouts } from '../lib/voxel/placement';
import type { VoxelMap } from '../lib/voxel/maps/index';

interface Callout { n: number; id: string; label: string }
interface Props { map: VoxelMap; layers: MapLayer[]; callouts: Callout[]; accent: string; ink: string; title: string; caption?: string | null }
const { map, layers, callouts, accent, ink, title, caption } = Astro.props;

const scene = await mapScene(map, layers.map(l => l.id), accent);
const W = scene.width, H = scene.height;
const { titleText, titleBox, placed } = placeCallouts(scene, callouts, title);
const titleLine = [title, caption].filter(Boolean).join(' · ');
---
<svg class="fmap fmap-pixel fmap-voxel" viewBox={`0 0 ${W} ${H}`} role="img"
     aria-label={`${titleLine}. ${callouts.map(c => `${c.n}: ${c.label}`).join('; ')}`}>
  <defs>
    {callouts.filter(c => scene.masks[c.id]).map(c => <clipPath id={`pxm-${c.id}`}><path d={scene.masks[c.id]} /></clipPath>)}
    <image id="vxscene-img" href={scene.src} width={W} height={H} style="image-rendering:pixelated" />
  </defs>
  <g id="pxscene"><use href="#vxscene-img" /></g>
  <rect class="px-dim" width={W} height={H} fill="#060606" />
  {callouts.filter(c => scene.masks[c.id]).map(c => (
    <g class="px-hl" data-layer={c.id}><use href="#vxscene-img" clip-path={`url(#pxm-${c.id})`} /></g>
  ))}
  <g class="px-hits">
    {callouts.filter(c => scene.masks[c.id]).map(c => <path class="map-hit" data-layer={c.id} d={scene.masks[c.id]} fill="transparent" />)}
  </g>
  {placed.map(c => (
    <g class="fmap-callout" data-layer={c.id} tabindex="0" role="button" aria-label={`${c.n}: ${c.label}`}>
      <path d={`M${c.x} ${c.y}L${c.tx} ${c.ty}`} stroke="#0c0c0c" stroke-width="2.2" />
      <path d={`M${c.x} ${c.y}L${c.tx} ${c.ty}`} stroke={accent} stroke-width="0.9" />
      <rect x={c.tx - 1.5} y={c.ty - 1.5} width="3" height="3" fill={accent} />
      <rect x={c.x - 6.5} y={c.y - 6.5} width="13" height="13" fill="#0c0c0c" />
      <rect x={c.x - 5.5} y={c.y - 5.5} width="11" height="11" fill={accent} />
      <rect class="co-face" x={c.x - 4.5} y={c.y - 4.5} width="9" height="9" fill="#0c0c0c" />
      <text x={c.x} y={c.y + 2.6} text-anchor="middle" class="fmap-num fmap-px co-num vx-num" fill={accent}>{c.n}</text>
    </g>
  ))}
  {/* The names, drawn last so a lit one is never under a neighbour's number. */}
  <g class="co-labels" aria-hidden="true">
    {placed.map(c => (
      <g class="co-label" data-layer={c.id}>
        <rect x={c.lx} y={c.ly} width={c.lw} height="13" fill="#0c0c0c" stroke={accent} stroke-width="0.8" />
        <text x={c.lx + 5} y={c.ly + 8.9} class="vx-label" textLength={c.tl} lengthAdjust="spacingAndGlyphs">{c.label}</text>
      </g>
    ))}
  </g>
  <rect x={titleBox.x} y={titleBox.y} width={titleBox.w} height={titleBox.h} fill={accent} />
  <text x="12" y="16.5" class="fmap-title fmap-px vx-title" fill={ink} textLength={titleBox.w - 12} lengthAdjust="spacingAndGlyphs">{titleText}</text>
</svg>
