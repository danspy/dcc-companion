---
import type { Prefs } from '../lib/prefs';
import type { BookRow } from '../lib/content';
import { BOOK_COUNT } from '../lib/progress';
/* The reading position, in two parts: the chip in the header's one row that
   says where the reader is, and the panel it opens under the header, with the
   eight books, the chapter picker and Show everything. It used to be a whole
   row of its own above the masthead, which scrolled away under it; on the
   homepage, which opens on the reader's floor, that left no way to another
   page in view, and on a phone the bar alone was three rows deep. */
interface Props { prefs: Prefs; books: BookRow[]; part: 'chip' | 'panel' }
const { prefs, books, part } = Astro.props;
const bookOf = (n: number) => books.find(b => b.id === n);
/* Each book carries its official colour and a readable ink (data/book-colors.json).
   The bar paints with them as fills and borders only: as text on the dark ground,
   the red and the purple fall under 4.5:1, so a colour is never the text itself. */
const tint = (n: number) => {
  const b = bookOf(n);
  return b?.accent ? `--bk:${b.accent};--bk-ink:${b.ink ?? '#0e0e0e'}` : undefined;
};
const saved = prefs.spoilers && prefs.book ? prefs.book : 0;
/* The one thing a reader does every visit is read on. So the panel opens on a
   single button for it: the next chapter, or the end of the book after its last,
   or the first chapter of the next book after a finished one. */
const countOf = (n: number) => bookOf(n)?.chapters ?? 0;
const next = !saved ? null
  : prefs.chapter && prefs.chapter < countOf(saved) ? { book: saved, chapter: prefs.chapter + 1, label: `Read another · ch ${prefs.chapter + 1}` }
  : prefs.chapter ? { book: saved, chapter: 0, label: `I finished book ${saved}` }
  : saved < BOOK_COUNT && countOf(saved + 1) ? { book: saved + 1, chapter: 1, label: `Started book ${saved + 1} · ch 1` }
  : null;
const state = !prefs.spoilers ? 'off' : prefs.book ? 'set' : 'unset';
---
{part === 'chip' && (
  <button class="pos" id="pos" type="button" aria-expanded="false" aria-controls="pick" data-saved={saved}
          title="Where you are in the books: everything here is sealed past it">
    <span class="pos-lead">I've read up to</span>
    <b class={`pos-val pos-${state}`} style={saved ? tint(saved) : undefined}>{state === 'off'
      ? <>Everything<span class="pos-more"> · spoilers off</span></>
      : state === 'set'
        ? <>Book {prefs.book}<span class="pos-more">{prefs.chapter ? ` · ch ${prefs.chapter}` : ' · finished'}</span></>
        : <>Pick <span class="pos-more">your </span>book</>}</b>
    <svg class="pos-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg>
  </button>
)}
{part === 'panel' && (
  <div class="pick" id="pick" hidden>
    <div class="pick-inner wrap">
      <!-- A book button opens its chapter picker below; it does not commit
           anything. One tap used to mean "I have finished this book", which
           unsealed the whole of it for a reader who had only just started. -->
      {next && (
        <div class="pick-next">
          <button class="btn btn-set" id="pick-next" type="button" data-book={next.book} data-chapter={next.chapter} style={tint(next.book)}>{next.label}</button>
          <span class="pick-now">Now: book {saved}{prefs.chapter ? `, chapter ${prefs.chapter}` : ', finished'}</span>
        </div>
      )}
      <div class="pick-books">
        <span class="pick-ask">Which book are you reading?</span>
        <div class="books" role="group" aria-label="Which book are you reading?">
          {Array.from({ length: BOOK_COUNT }, (_, i) => i + 1).map(n => (
            <button class="bk" type="button" data-book={n} data-title={bookOf(n)?.title ?? ''} style={tint(n)}
                    data-chapters={bookOf(n)?.chapters ?? 0}
                    aria-pressed={prefs.spoilers && n === prefs.book} aria-expanded="false"
                    title={bookOf(n)?.title}>{n}</button>
          ))}
        </div>
        <span class="spacer"></span>
        <button class="btn" id="spoilers" type="button" aria-pressed={!prefs.spoilers}>Show everything</button>
      </div>
      <div class="pick-book" id="pick-book" hidden>
        <div class="pick-head">
          <span class="pick-no" id="pick-no">Book <span id="pick-n"></span></span>
          <b id="pick-title"></b>
        </div>
        <p class="pick-q">Where are you in it?</p>
        <div class="pick-row" id="pick-range-row">
          <input type="range" id="pick-range" min="1" value="1" aria-label="Chapter" />
          <span class="pick-ch">
            <button class="btn pick-step" type="button" data-step="-1" aria-label="One chapter back">−</button>
            Ch <input type="number" id="pick-num" min="1" value="1" aria-label="Chapter number" /> <span id="pick-of"></span>
            <button class="btn pick-step" type="button" data-step="1" aria-label="One chapter on">+</button>
          </span>
        </div>
        <p class="pick-hint" id="pick-hint"></p>
        <div class="pick-actions">
          <button class="btn btn-set" id="pick-set" type="button">Save</button>
          <button class="btn" id="pick-done" type="button">I finished it</button>
          <button class="btn pick-quiet" id="pick-cancel" type="button">Cancel</button>
          <span class="spacer"></span>
          <button class="btn pick-quiet" id="pick-clear" type="button" hidden>Clear my progress</button>
        </div>
      </div>
    </div>
  </div>
)}

<style>
  /* The chip: the label, the position on its book's colour, a caret. */
  .pos { display: inline-flex; align-items: center; gap: 9px; flex: none; height: 34px; padding: 0 10px;
         background: transparent; border: 1px solid var(--color-line); color: var(--color-grey-300); cursor: pointer;
         font-family: var(--font-mono); font-size: var(--type-label); letter-spacing: var(--ls-label); text-transform: uppercase;
         transition: border-color .15s; }
  .pos:hover, .pos[aria-expanded="true"] { border-color: var(--bk-open, var(--color-gold)); }
  .pos:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 2px; }
  .pos-lead { color: var(--color-grey-500); white-space: nowrap; }
  .pos-val { font-weight: 700; white-space: nowrap; color: var(--color-gold); }
  .pos-set { background: var(--bk); color: var(--bk-ink); padding: 2px 7px; }
  /* Nothing chosen yet is a prompt, not a value — colour it differently. */
  .pos-unset { color: var(--color-blood); }
  .pos-off { color: var(--color-grey-100); }
  .pos-caret { width: 10px; height: 6px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.6; transition: rotate .2s; }
  .pos[aria-expanded="true"] .pos-caret { rotate: 180deg; }
  @media (max-width: 980px) { .pos-lead { display: none; } }
  @media (max-width: 420px) { .pos-more { display: none; } .pos { padding: 0 8px; gap: 7px; } }

  /* The panel: the books in a row that scrolls itself on a phone, then the chosen book's chapter */
  .pick-books { display: flex; align-items: center; gap: 10px 14px; flex-wrap: wrap; }
  .pick-ask { font-family: var(--font-mono); font-size: var(--type-label); letter-spacing: var(--ls-label);
              text-transform: uppercase; color: var(--color-grey-500); }
  .books { display: flex; gap: 4px; flex-wrap: nowrap; min-width: 0;
           overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; }
  .bk { flex: none; }
  .bk { font-family: var(--font-mono); font-size: 13px; font-weight: 600;
        width: 32px; height: 30px; background: transparent; color: var(--color-grey-300);
        border: 1px solid var(--color-line); cursor: pointer;
        transition: background .12s, color .12s, border-color .12s; }
  .bk:hover { border-color: var(--color-grey-700); color: var(--color-grey-100); }
  /* Each number wears its book's colour as an underline at rest, the full
     border on hover or while its picker is open, and the fill once saved. */
  .bk { box-shadow: inset 0 -3px 0 var(--bk, var(--color-gold)); }
  .bk:hover, .bk[aria-expanded="true"] { border-color: var(--bk, var(--color-gold));
                                         color: var(--color-grey-100); }
  .bk[aria-pressed="true"] { background: var(--bk, var(--color-gold)); color: var(--bk-ink, #101010);
                             border-color: var(--bk, var(--color-gold)); font-weight: 700;
                             box-shadow: none; }
  .spacer { flex: 1 1 auto; }
  .pick-book { display: grid; gap: 10px; padding-top: 4px; border-top: 1px solid var(--color-line-soft); }
  .pick-book[hidden] { display: none; }

  /* dropped over the page from under the header, never part of it: the header
     keeps one height, which the homepage measures its room from */
  .pick { position: absolute; left: 0; right: 0; top: 100%; border-top: 3px solid var(--acc, var(--color-gold));
          border-bottom: 1px solid var(--color-line); background: var(--color-panel); box-shadow: 0 18px 40px #000a;
          max-height: calc(100dvh - 60px); overflow-y: auto; overscroll-behavior: contain; }
  .pick-no { font-family: var(--font-mono); font-size: var(--type-label); letter-spacing: var(--ls-label);
             text-transform: uppercase; font-weight: 700; padding: 3px 7px;
             background: var(--acc, var(--color-gold)); color: var(--acc-ink, #101010); }
  .pick[hidden] { display: none; }
  .pick-inner { padding-block: 14px 16px; display: grid; gap: 10px; }
  .pick-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .pick-head b { font-family: var(--font-display); font-size: var(--type-sect);
                 color: var(--color-grey-100); font-weight: 700; line-height: 1.1; }
  .pick-q { margin: 0; color: var(--color-grey-300); font-size: var(--type-meta); }
  .pick-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .pick-row[hidden] { display: none; }
  /* read on: the panel's first and biggest button, in the book's colour */
  .pick-next { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 0 0 16px; padding-bottom: 16px; border-bottom: 1px solid var(--color-line); }
  .pick-next .btn-set { background: var(--bk, var(--color-gold)); color: var(--bk-ink, #0e0e0e); border-color: var(--bk, var(--color-gold)); font-size: var(--type-ui); padding: 11px 16px; }
  .pick-now { font-family: var(--font-mono); font-size: var(--type-label); letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--color-grey-300); }
  .pick-step { min-width: 34px; padding-inline: 0; justify-content: center; }
  #pick-range { flex: 1 1 220px; min-width: 0; accent-color: var(--acc, var(--color-gold)); }
  .pick-ch { font-family: var(--font-mono); font-size: var(--type-ui); color: var(--color-grey-300);
             display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  #pick-num { font-family: var(--font-mono); font-size: 13px; width: 58px; height: 30px;
              background: transparent; color: var(--color-grey-100);
              border: 1px solid var(--color-line); padding: 0 7px; }
  #pick-num:focus { outline: none; border-color: var(--acc, var(--color-gold)); }
  .pick-hint { margin: 0; color: var(--color-grey-500); font-size: var(--type-meta); }
  .pick-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .btn-set { border-color: var(--acc, var(--color-gold)); background: var(--acc, var(--color-gold));
             color: var(--acc-ink, #101010); font-weight: 700; }
  .btn-set:hover { border-color: var(--acc, var(--color-gold)); color: var(--acc-ink, #101010);
                   filter: brightness(1.12); }
  #pick-done:hover { border-color: var(--acc, var(--color-gold)); }
  .pick-quiet { border-color: transparent; }
</style>

<script>
  /* The position lives in one cookie the server reads on every request, so a
     change has to round-trip: write, then reload. Nothing is written until the
     reader presses Save, I finished it, Clear or Show everything: the chip only
     opens the panel, and a book there only opens its chapter picker. Delegated
     on document, and every selector scoped to the panel: a beat's book stamp is
     a `.bk` too, and a bare `.bk` once caught a click on one. */
  const COOKIE = 'dcc_pos';

  function read() {
    const hit = document.cookie.split('; ').find(c => c.startsWith(COOKIE + '='));
    if (!hit) return { book: 0, chapter: 0, spoilers: true };
    try { return JSON.parse(decodeURIComponent(hit.slice(COOKIE.length + 1))); }
    catch { return { book: 0, chapter: 0, spoilers: true }; }
  }

  function write(next: Record<string, unknown>) {
    /* Where the reader moved from: the homepage offers what is new since then.
       Only a real position counts, and only the latest move. */
    const prev = read();
    if (prev.spoilers && prev.book && (prev.book !== next.book || prev.chapter !== next.chapter)) {
      /* A reading session is moves less than eight hours apart: tapping on a chapter
         at a time keeps the session's starting point, so "what's new" covers all of it. */
      let since = { book: prev.book, chapter: prev.chapter, t: Date.now() };
      try {
        const hit = document.cookie.split('; ').find(c => c.startsWith('dcc_since='));
        const old = hit ? JSON.parse(decodeURIComponent(hit.slice(10))) : null;
        if (old && Date.now() - (Number(old.t) || 0) < 8 * 3600e3) since = { book: old.book, chapter: old.chapter, t: Date.now() };
      } catch { /* a fresh session, then */ }
      document.cookie = `dcc_since=${encodeURIComponent(JSON.stringify(since))}; path=/; max-age=31536000; samesite=lax`;
    }
    const value = encodeURIComponent(JSON.stringify(next));
    document.cookie = `${COOKIE}=${value}; path=/; max-age=31536000; samesite=lax`;
    location.reload();
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const books = () => document.querySelectorAll<HTMLElement>('#pick .bk');
  let open = 0;

  function setChapter(n: number) {
    const max = Number($<HTMLInputElement>('pick-range').max) || 1;
    const c = Math.min(max, Math.max(1, Math.round(n) || 1));
    $<HTMLInputElement>('pick-range').value = String(c);
    $<HTMLInputElement>('pick-num').value = String(c);
    $('pick-set').textContent = `Save · up to ch ${c}`;
    $('pick-hint').textContent = c === 1
      ? 'Just started: only the opening chapter is unsealed.'
      : `Everything up to the end of chapter ${c} is unsealed, and nothing after it.`;
  }

  const isOpen = () => !$('pick').hidden;
  function close(refocus = false) {
    if (!isOpen()) return;
    $('pick').hidden = true; $('pick-book').hidden = true;
    $('pick').style.removeProperty('--acc'); $('pick').style.removeProperty('--acc-ink');
    books().forEach(b => b.setAttribute('aria-expanded', 'false'));
    $('pos').setAttribute('aria-expanded', 'false');
    open = 0;
    if (refocus) $('pos').focus();
  }
  // the panel, on the saved book if there is one, or on the row of books
  function openPanel() {
    document.querySelector<HTMLDetailsElement>('#top .menu')?.removeAttribute('open');
    $('pick').hidden = false;
    $('pos').setAttribute('aria-expanded', 'true');
    const saved = document.querySelector<HTMLElement>(`#pick .bk[data-book="${$('pos').dataset.saved}"]`);
    if (saved) show(saved); else books()[0]?.focus();
  }

  function show(btn: HTMLElement) {
    const n = Number(btn.dataset.book);
    if (open === n) return;
    const state = read();
    const chapters = Number(btn.dataset.chapters) || 0;
    open = n;
    books().forEach(b => b.setAttribute('aria-expanded', String(b === btn)));
    $('pick-n').textContent = String(n);
    const cs = getComputedStyle(btn);
    $('pick').style.setProperty('--acc', cs.getPropertyValue('--bk').trim() || '');
    $('pick').style.setProperty('--acc-ink', cs.getPropertyValue('--bk-ink').trim() || '');
    $('pick-title').textContent = btn.dataset.title || '';
    $('pick-done').textContent = `I finished book ${n}`;
    const saved = state.spoilers && state.book === n;
    $('pick-clear').hidden = !state.book;
    if (chapters) {
      $('pick-range-row').hidden = false;
      $('pick-set').hidden = false;
      $<HTMLInputElement>('pick-range').max = String(chapters);
      $<HTMLInputElement>('pick-num').max = String(chapters);
      $('pick-of').textContent = `of ${chapters}`;
      // Reopening the saved book starts where the reader left it; any other
      // book starts at the beginning, never at the end.
      setChapter(saved && state.chapter ? state.chapter : 1);
    } else {
      $('pick-range-row').hidden = true;
      $('pick-set').hidden = true;
      $('pick-hint').textContent = 'No chapter list for this book yet, so it is all or nothing.';
    }
    $('pick-book').hidden = false;
    $<HTMLInputElement>('pick-range').focus({ preventScroll: true });
  }

  document.addEventListener('click', e => {
    const target = e.target as HTMLElement;
    if (target.closest('#pos')) { if (isOpen()) close(); else openPanel(); return; }
    // a click anywhere outside the header puts the panel away, as any dropdown does
    if (!target.closest('#top')) { close(); return; }
    const book = target.closest<HTMLElement>('#pick .bk');
    if (book) { show(book); return; }
    const state = read();
    const stepBtn = target.closest<HTMLElement>('.pick-step');
    if (stepBtn) { setChapter(Number($<HTMLInputElement>('pick-num').value) + Number(stepBtn.dataset.step)); return; }
    const nextBtn = target.closest<HTMLElement>('#pick-next');
    if (nextBtn) { write({ ...state, book: Number(nextBtn.dataset.book), chapter: Number(nextBtn.dataset.chapter), spoilers: true }); return; }
    if (target.closest('#pick-set')) {
      write({ ...state, book: open, chapter: Number($<HTMLInputElement>('pick-num').value) || 1, spoilers: true });
      return;
    }
    // Chapter 0 is how the position says "finished" — see frontierOf.
    if (target.closest('#pick-done')) { write({ ...state, book: open, chapter: 0, spoilers: true }); return; }
    if (target.closest('#pick-clear')) { write({ ...state, book: 0, chapter: 0, spoilers: true }); return; }
    if (target.closest('#pick-cancel')) { close(true); return; }
    if (target.closest('#spoilers')) { write({ ...state, spoilers: !state.spoilers }); return; }
  });

  document.addEventListener('input', e => {
    const t = e.target as HTMLElement;
    if (t.id === 'pick-range' || t.id === 'pick-num') setChapter(Number((t as HTMLInputElement).value));
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && isOpen()) { e.preventDefault(); close(true); return; }
    if (e.key === 'Enter' && open && (e.target as HTMLElement).id === 'pick-num') $('pick-set').click();
  });
  // the menu and the panel share the room under the header: one at a time
  document.querySelector('#top .menu')?.addEventListener('toggle', e => { if ((e.target as HTMLDetailsElement).open) close(); });
</script>
