---
import type { Prefs } from '../lib/prefs';
import type { BookRow } from '../lib/content';
import { BOOK_COUNT } from '../lib/progress';

interface Props { prefs: Prefs; books: BookRow[] }
const { prefs, books } = Astro.props;
const bookOf = (n: number) => books.find(b => b.id === n);
/* Each book carries its official colour and a readable ink (data/book-colors.json).
   The bar paints with them as fills and borders only: as text on the dark ground,
   the red and the purple fall under 4.5:1, so a colour is never the text itself. */
const tint = (n: number) => {
  const b = bookOf(n);
  return b?.accent ? `--bk:${b.accent};--bk-ink:${b.ink ?? '#0e0e0e'}` : undefined;
};
const saved = prefs.spoilers && prefs.book ? prefs.book : 0;
---
<div class="gate">
  <div class="gate-inner wrap">
    <span class="eyebrow">
      I've read up to —
      <b class={prefs.spoilers && !prefs.book ? 'unset' : saved ? 'chip' : undefined}
         style={saved ? tint(saved) : undefined}>{!prefs.spoilers
        ? 'spoilers off'
        : prefs.book
          ? `Book ${prefs.book}${prefs.chapter ? ` · ch ${prefs.chapter}` : ' · finished'}`
          : 'not set — pick a book'}</b>
    </span>

    <!-- A book button opens the picker below; it does not commit anything.
         One tap used to mean "I have finished this book", which unsealed the
         whole of it for a reader who had only just started. -->
    <div class="books" role="group" aria-label="Which book are you reading?">
      {Array.from({ length: BOOK_COUNT }, (_, i) => i + 1).map(n => (
        <button class="bk" data-book={n} data-title={bookOf(n)?.title ?? ''} style={tint(n)}
                data-chapters={bookOf(n)?.chapters ?? 0}
                aria-pressed={prefs.spoilers && n === prefs.book} aria-expanded="false"
                aria-controls="pick" title={bookOf(n)?.title}>{n}</button>
      ))}
    </div>
    <span class="spacer"></span>
    <button class="btn" id="spoilers" aria-pressed={!prefs.spoilers}>Show everything</button>
  </div>

  <div class="pick" id="pick" hidden data-book={prefs.book} data-chapter={prefs.chapter}>
    <div class="pick-inner wrap">
      <div class="pick-head">
        <span class="pick-no" id="pick-no">Book <span id="pick-n"></span></span>
        <b id="pick-title"></b>
      </div>
      <p class="pick-q">Where are you in it?</p>
      <div class="pick-row" id="pick-range-row">
        <input type="range" id="pick-range" min="1" value="1" aria-label="Chapter" />
        <span class="pick-ch">Ch <input type="number" id="pick-num" min="1" value="1" aria-label="Chapter number" /> <span id="pick-of"></span></span>
      </div>
      <p class="pick-hint" id="pick-hint"></p>
      <div class="pick-actions">
        <button class="btn btn-set" id="pick-set">Save</button>
        <button class="btn" id="pick-done">I finished it</button>
        <button class="btn pick-quiet" id="pick-cancel">Cancel</button>
        <span class="spacer"></span>
        <button class="btn pick-quiet" id="pick-clear" hidden>Clear my progress</button>
      </div>
    </div>
  </div>
</div>

<style>
  .gate { position: sticky; top: 0; z-index: 50; background: #0b0b0bf2;
          backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-line); }
  .gate-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px;
                padding-block: 12px; }
  .eyebrow b { color: var(--color-gold); font-weight: 700; }
  /* Nothing chosen yet is a prompt, not a value — colour it differently. */
  .eyebrow b.unset { color: var(--color-blood); }
  /* One row that scrolls itself on a phone, contained like the masthead's. */
  .books { display: flex; gap: 4px; flex-wrap: nowrap; min-width: 0;
           overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; }
  .bk { flex: none; }
  .bk { font-family: var(--font-mono); font-size: 13px; font-weight: 600;
        width: 32px; height: 30px; background: transparent; color: var(--color-grey-300);
        border: 1px solid var(--color-line); cursor: pointer;
        transition: background .12s, color .12s, border-color .12s; }
  .bk:hover { border-color: var(--color-grey-700); color: var(--color-grey-100); }
  /* Each number wears its book's colour as an underline at rest, the full
     border on hover or while its picker is open, and the fill once saved. */
  .bk { box-shadow: inset 0 -3px 0 var(--bk, var(--color-gold)); }
  .bk:hover, .bk[aria-expanded="true"] { border-color: var(--bk, var(--color-gold));
                                         color: var(--color-grey-100); }
  .bk[aria-pressed="true"] { background: var(--bk, var(--color-gold)); color: var(--bk-ink, #101010);
                             border-color: var(--bk, var(--color-gold)); font-weight: 700;
                             box-shadow: none; }
  .eyebrow b.chip { background: var(--bk); color: var(--bk-ink); padding: 2px 7px; margin-left: 2px; }
  .spacer { flex: 1 1 auto; }

  .pick { border-top: 3px solid var(--acc, var(--color-gold)); background: var(--color-panel); }
  .pick-no { font-family: var(--font-mono); font-size: var(--type-label); letter-spacing: var(--ls-label);
             text-transform: uppercase; font-weight: 700; padding: 3px 7px;
             background: var(--acc, var(--color-gold)); color: var(--acc-ink, #101010); }
  .pick[hidden] { display: none; }
  .pick-inner { padding-block: 14px 16px; display: grid; gap: 10px; }
  .pick-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .pick-head b { font-family: var(--font-display); font-size: var(--type-sect);
                 color: var(--color-grey-100); font-weight: 700; line-height: 1.1; }
  .pick-q { margin: 0; color: var(--color-grey-300); font-size: var(--type-meta); }
  .pick-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .pick-row[hidden] { display: none; }
  #pick-range { flex: 1 1 220px; min-width: 0; accent-color: var(--acc, var(--color-gold)); }
  .pick-ch { font-family: var(--font-mono); font-size: var(--type-ui); color: var(--color-grey-300);
             display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  #pick-num { font-family: var(--font-mono); font-size: 13px; width: 58px; height: 30px;
              background: transparent; color: var(--color-grey-100);
              border: 1px solid var(--color-line); padding: 0 7px; }
  #pick-num:focus { outline: none; border-color: var(--acc, var(--color-gold)); }
  .pick-hint { margin: 0; color: var(--color-grey-500); font-size: var(--type-meta); }
  .pick-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .btn-set { border-color: var(--acc, var(--color-gold)); background: var(--acc, var(--color-gold));
             color: var(--acc-ink, #101010); font-weight: 700; }
  .btn-set:hover { border-color: var(--acc, var(--color-gold)); color: var(--acc-ink, #101010);
                   filter: brightness(1.12); }
  #pick-done:hover { border-color: var(--acc, var(--color-gold)); }
  .pick-quiet { border-color: transparent; }
</style>

<script>
  /* The position lives in one cookie the server reads on every request, so a
     change has to round-trip: write, then reload. Nothing is written until the
     reader presses Save, I finished it, or Clear — choosing a book only opens
     the picker. Delegated on document because the header survives navigations. */
  const COOKIE = 'dcc_pos';

  function read() {
    const hit = document.cookie.split('; ').find(c => c.startsWith(COOKIE + '='));
    if (!hit) return { book: 0, chapter: 0, spoilers: true };
    try { return JSON.parse(decodeURIComponent(hit.slice(COOKIE.length + 1))); }
    catch { return { book: 0, chapter: 0, spoilers: true }; }
  }

  function write(next: Record<string, unknown>) {
    const value = encodeURIComponent(JSON.stringify(next));
    document.cookie = `${COOKIE}=${value}; path=/; max-age=31536000; samesite=lax`;
    location.reload();
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  let open = 0;

  function setChapter(n: number) {
    const max = Number($<HTMLInputElement>('pick-range').max) || 1;
    const c = Math.min(max, Math.max(1, Math.round(n) || 1));
    $<HTMLInputElement>('pick-range').value = String(c);
    $<HTMLInputElement>('pick-num').value = String(c);
    $('pick-set').textContent = `Save · up to ch ${c}`;
    $('pick-hint').textContent = c === 1
      ? 'Just started: only the opening chapter is unsealed.'
      : `Everything up to the end of chapter ${c} is unsealed, and nothing after it.`;
  }

  function close() {
    $('pick').hidden = true;
    document.querySelectorAll('.bk').forEach(b => b.setAttribute('aria-expanded', 'false'));
    open = 0;
  }

  function show(btn: HTMLElement) {
    const n = Number(btn.dataset.book);
    if (open === n) { close(); return; }
    const state = read();
    const chapters = Number(btn.dataset.chapters) || 0;
    open = n;
    document.querySelectorAll('.bk').forEach(b =>
      b.setAttribute('aria-expanded', String(b === btn)));
    $('pick-n').textContent = String(n);
    const cs = getComputedStyle(btn);
    $('pick').style.setProperty('--acc', cs.getPropertyValue('--bk').trim() || '');
    $('pick').style.setProperty('--acc-ink', cs.getPropertyValue('--bk-ink').trim() || '');
    $('pick-title').textContent = btn.dataset.title || '';
    $('pick-done').textContent = `I finished book ${n}`;
    const saved = state.spoilers && state.book === n;
    $('pick-clear').hidden = !state.book;
    if (chapters) {
      $('pick-range-row').hidden = false;
      $('pick-set').hidden = false;
      $<HTMLInputElement>('pick-range').max = String(chapters);
      $<HTMLInputElement>('pick-num').max = String(chapters);
      $('pick-of').textContent = `of ${chapters}`;
      // Reopening the saved book starts where the reader left it; any other
      // book starts at the beginning, never at the end.
      setChapter(saved && state.chapter ? state.chapter : 1);
    } else {
      $('pick-range-row').hidden = true;
      $('pick-set').hidden = true;
      $('pick-hint').textContent = 'No chapter list for this book yet, so it is all or nothing.';
    }
    $('pick').hidden = false;
    $<HTMLInputElement>('pick-range').focus({ preventScroll: true });
  }

  document.addEventListener('click', e => {
    const target = e.target as HTMLElement;
    const book = target.closest<HTMLElement>('.bk');
    if (book) { show(book); return; }
    const state = read();
    if (target.closest('#pick-set')) {
      write({ ...state, book: open, chapter: Number($<HTMLInputElement>('pick-num').value) || 1, spoilers: true });
      return;
    }
    // Chapter 0 is how the position says "finished" — see frontierOf.
    if (target.closest('#pick-done')) { write({ ...state, book: open, chapter: 0, spoilers: true }); return; }
    if (target.closest('#pick-clear')) { write({ ...state, book: 0, chapter: 0, spoilers: true }); return; }
    if (target.closest('#pick-cancel')) { close(); return; }
    if (target.closest('#spoilers')) { write({ ...state, spoilers: !state.spoilers }); return; }
  });

  document.addEventListener('input', e => {
    const t = e.target as HTMLElement;
    if (t.id === 'pick-range' || t.id === 'pick-num') setChapter(Number((t as HTMLInputElement).value));
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && open) { close(); return; }
    if (e.key === 'Enter' && open && (e.target as HTMLElement).id === 'pick-num') $('pick-set').click();
  });
</script>
