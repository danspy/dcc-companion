---
import Layout from '../layouts/Layout.astro';
import Sealed from '../components/Sealed.astro';
import { reveals, UNSET_COPY } from '../lib/spoiler';
import { getEntities, getAllBeats, coverage, readGate, taglineFor, KIND_LABELS, KIND_ORDER } from '../lib/content';

const { gate } = await readGate(Astro.cookies);
const [entities, beats] = await Promise.all([getEntities(), getAllBeats()]);

const beatsByEntity = new Map<string, typeof beats>();
for (const b of beats) {
  const list = beatsByEntity.get(b.entityId) ?? [];
  list.push(b);
  beatsByEntity.set(b.entityId, list);
}

/* Short chip labels. KIND_LABELS is written for section headings ("Items &
   artifacts"), which is too long to sit in a row of buttons. */
const CHIP_LABELS: Record<string, string> = {
  character: 'Characters', item: 'Items', mechanic: 'Mechanics',
  faction: 'Factions', place: 'Places', thread: 'Threads',
};

const groups = KIND_ORDER.map(kind => {
  const rows = entities.filter(e => e.kind === kind);
  return {
    kind,
    label: KIND_LABELS[kind],
    chip: CHIP_LABELS[kind] ?? KIND_LABELS[kind],
    rows,
    /* Counts are of entries this reader has *met*. The full count would tell
       someone on book 1 how many people are still coming, which is the same
       structural leak the sealed beat stamps were. */
    met: rows.filter(e => reveals(gate, e.revealedAt)).length,
  };
}).filter(g => g.rows.length);
const metTotal = groups.reduce((n, g) => n + g.met, 0);

/* The searchable string for one row, assembled from what this reader may
   actually see. A sealed row gets none, and that is what makes filtering safe
   by construction rather than by rule: there is no name in the document to
   match, so no query can surface one. */
const findable = (e: (typeof entities)[number]) =>
  [e.name, ...((e.aka ?? []) as string[]), e.role, taglineFor(e, gate)]
    .join(' ')
    .toLowerCase();
---
<Layout title="Who & What">
  <section class="wrap head">
    <p class="eyebrow">02</p>
    <h1>Who &amp; What</h1>
    <p class="standfirst">Everything you have walked into, logged and filed. A name enters the
      record the moment you meet it. What becomes of it is a separate entry, and that one stays
      shut.</p>
    {gate.spoilers && gate.fresh && (
      <p class="sys" style="max-width:var(--measure);margin-top:20px">
        <b>*** No position set ***</b>{UNSET_COPY}
      </p>
    )}
  </section>

  <section class="wrap finder-wrap">
    <div class="finder">
      <label class="finder-search" for="find">
        <span class="vh">Search entries you have met</span>
        <input id="find" type="search" autocomplete="off" spellcheck="false"
               disabled={metTotal === 0}
               placeholder={metTotal === 0 ? 'Set your position to search' : 'Search names, roles and descriptions'} />
        <kbd>/</kbd>
      </label>
      <div class="finder-chips">
        {groups.map(g => (
          <button type="button" class="chip-btn" data-chip={g.kind}
                  aria-pressed="false" disabled={g.met === 0}>
            {g.chip}<span class="n">{g.met}</span>
          </button>
        ))}
        <button type="button" class="chip-btn solo" id="metonly"
                aria-pressed="false" disabled={metTotal === 0}>Met only</button>
      </div>
      <p class="tally" id="tally" aria-live="polite" role="status"></p>
    </div>
  </section>

  <section class="wrap" id="nomatch" hidden>
    <p class="sys" style="max-width:var(--measure)">
      <b>*** Nothing matches ***</b>Nothing you have met answers to that, crawler. Try fewer letters,
      or read further.
    </p>
  </section>

  {groups.map(group => (
    <section class="wrap group" data-group={group.kind}>
      <h2>{group.label}</h2>
      <div class="grid-cells">
        {group.rows.map(e => {
          const known = reveals(gate, e.revealedAt);
          const own = beatsByEntity.get(e.id) ?? [];
          const cov = coverage(own, gate);
          return (
            <div class="cell" data-kind={e.kind} data-met={known ? '1' : '0'}
                 data-find={known ? findable(e) : ''}>
              <div class="cell-head">
                {known
                  ? <h3><a href={`/entity/${e.id}`}>{e.name}</a></h3>
                  : <h3 class="redact">▓▓▓▓▓▓▓▓</h3>}
                {known && own.length > 0 && (
                  <span class="cov" title={`${cov.shown} of ${cov.total} entries unsealed`}>
                    {cov.shown}/{cov.total}
                  </span>
                )}
              </div>
              <p class="role">{known ? e.role : 'Not yet met'}</p>
              {known
                ? <p class={`tagline${e.voice === 'self' ? ' spoken' : ''}`}>{taglineFor(e, gate)}</p>
                : <Sealed at={e.revealedAt} compact />}
            </div>
          );
        })}
      </div>
    </section>
  ))}
</Layout>

<style>
  .head { padding-block: 48px 8px; }
  h1 { font-size: clamp(40px, 7vw, 72px); font-weight: 800; margin-top: 10px; }
  .standfirst { font-size: 16.5px; color: var(--color-grey-200); max-width: var(--measure); margin-top: 18px; }
  .group { padding-top: 40px; }
  .group h2 { font-size: 26px; font-weight: 700; color: var(--color-gold); margin-bottom: 14px; }
  .cell-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .cell h3 { font-size: 21px; font-weight: 700; color: #fff; }
  .cell h3 a { color: inherit; }
  .cell h3 a:hover { color: var(--color-gold); text-decoration: none; }
  .cov { font-family: var(--font-mono); font-size: 11px; color: var(--color-grey-700); flex: none; }
  .role { font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em;
          text-transform: uppercase; color: var(--color-gold); margin: 2px 0 10px; }
  .tagline { font-size: 14.5px; color: var(--color-grey-200); margin: 0; }

  /* ---- the finder ------------------------------------------------------
     Not sticky: the gate bar already owns `top: 0`, and stacking a second
     sticky element under one whose height wraps is a measurement problem
     nobody needs. `/` focuses this and scrolls it into view instead. */

  /* The bar itself is in the shared component layer (src/styles/global.css),
     because /when asks the same question of the same set and had grown a
     near-identical copy with slightly different numbers. */
  .chip-btn.solo { margin-left: auto; }

  /* Visually hidden but read aloud. */
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden;
        clip-path: inset(50%); white-space: nowrap; }

  /* A grid item keeps its box under the UA's [hidden] rule in some engines. */
  .cell[hidden], .group[hidden] { display: none !important; }

  @media (max-width: 560px) {
    .chip-btn.solo { margin-left: 0; }
  }
</style>

<script>
  /* Filtering happens over the rendered rows, which is what keeps it honest: a
     sealed row carries no name, no role and no tagline in the document, so
     `data-find` is empty for it and no query can ever surface one. The only
     way to widen this is to read further. */
  const box = document.getElementById('find') as HTMLInputElement | null;
  const tally = document.getElementById('tally');
  const nomatch = document.getElementById('nomatch');
  const metOnlyBtn = document.getElementById('metonly');

  if (box && tally) {
    const cells = Array.from(document.querySelectorAll<HTMLElement>('.cell'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('.group'));
    const chips = Array.from(document.querySelectorAll<HTMLElement>('.chip-btn[data-chip]'));
    const metTotal = cells.filter(c => c.dataset.met === '1').length;

    const kinds = new Set<string>();
    let metOnly = false;

    /* Match at word starts, not anywhere. `check-pages.mjs` learned this the
       hard way: without a boundary, "Tran" matches inside "transparent" and the
       results drown in accidents. "ran" no longer finds Tran, which is correct;
       a reader typing three letters means the start of a word. */
    const matcher = (q: string) => {
      const escaped = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      try { return new RegExp(`\\b${escaped}`, 'i'); }
      catch { return null; }
    };

    const apply = () => {
      const q = box.value.trim().toLowerCase();
      const re = q.length > 0 ? matcher(q) : null;
      /* A redacted row can never match a query or a kind filter usefully, so
         narrowing implies hiding them. The toggle then only matters when the
         reader wants a clean list with no filter applied. */
      const hideSealed = metOnly || q.length > 0 || kinds.size > 0;
      let shown = 0;

      for (const cell of cells) {
        const met = cell.dataset.met === '1';
        const okMet = !hideSealed || met;
        const okKind = kinds.size === 0 || kinds.has(cell.dataset.kind ?? '');
        const okQuery = !re || re.test(cell.dataset.find ?? '');
        const visible = okMet && okKind && okQuery;
        cell.hidden = !visible;
        if (visible) shown++;
      }

      for (const group of groups) {
        const any = Array.from(group.querySelectorAll<HTMLElement>('.cell')).some(c => !c.hidden);
        group.hidden = !any;
      }

      const filtering = q.length > 0 || kinds.size > 0 || metOnly;
      tally.textContent = filtering ? `${shown} of ${metTotal} shown` : '';
      if (nomatch) nomatch.hidden = shown > 0 || !filtering;
    };

    box.addEventListener('input', apply);

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const kind = chip.dataset.chip!;
        const on = chip.getAttribute('aria-pressed') === 'true';
        chip.setAttribute('aria-pressed', String(!on));
        if (on) kinds.delete(kind); else kinds.add(kind);
        apply();
      });
    }

    metOnlyBtn?.addEventListener('click', () => {
      metOnly = !metOnly;
      metOnlyBtn.setAttribute('aria-pressed', String(metOnly));
      apply();
    });

    document.addEventListener('keydown', e => {
      const target = e.target as HTMLElement | null;
      const typing = target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName);
      if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey && !e.altKey) {
        e.preventDefault();
        box.scrollIntoView({ block: 'center' });
        box.focus();
        return;
      }
      if (e.key === 'Escape' && target === box) {
        if (box.value) { box.value = ''; apply(); } else { box.blur(); }
      }
    });
  }
</script>
