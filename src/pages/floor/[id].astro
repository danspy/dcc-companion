    .mapframe.phone-ready .explore-open { display: inline-flex; align-items: center; gap: 8px; position: absolute; right: 10px; bottom: 10px; z-index: 2;
                    padding: 9px 13px; border: 1px solid var(--map-accent); background: #0c0c0cee; color: #fff; cursor: pointer;
                    font-family: var(--font-mono); font-size: var(--type-ui); letter-spacing: var(--ls-label); text-transform: uppercase; }
    .mapframe.phone-ready .explore-open span { color: var(--map-accent); }
    /* the key: its first places, the rest one tap away */
    .mapframe.phone-ready:not(.keys-open) .mapkey li:nth-child(n+7) { display: none; }
    .mapframe.phone-ready .keymore { display: flex; width: 100%; justify-content: center; padding: 12px; margin: 0; border: 0; border-top: 1px solid var(--color-line);
               background: none; color: var(--color-gold); cursor: pointer;
