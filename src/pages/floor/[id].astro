             min-width: 96px; display: flex; align-items: center; justify-content: center; padding: 14px 16px 10px; }
  h1 { font-size: clamp(38px, 6vw, 64px); font-weight: 800; margin-top: 4px; }
  .arrival { max-width: calc(var(--measure) + 34px); margin: 24px 0 0; }
