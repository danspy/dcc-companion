  .playbtn.is-playing .i-pause { display: inline; }
  .scrub-track { position: relative; flex: 1 1 auto; min-width: 0; padding-bottom: 24px; }
  #scrubber { width: 100%; margin: 8px 0 0; accent-color: var(--color-gold); cursor: pointer; }
