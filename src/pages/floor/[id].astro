    .mapframe.is-explore { position: fixed; inset: 0; z-index: 200; margin: 0; border: 0; display: flex; flex-direction: column; background: #0c0c0c; }
    .is-explore .explore-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex: none;
