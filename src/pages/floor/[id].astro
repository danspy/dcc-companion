  /* Map text is set in the System's face; sizes are in the drawing's own units. */
  /* Highlighting. The scene dims itself and redraws the one feature through
     its own mask, so the lit feature keeps its colours. */
  :global(.fmap g[data-layer]), :global(.fmap .fmap-callout) { transition: opacity .15s ease; }
