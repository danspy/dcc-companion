---
import Layout from '../../layouts/Layout.astro';
import Sealed from '../../components/Sealed.astro';
import { readPrefs } from '../../lib/prefs';
import { gateFor, reveals } from '../../lib/spoiler';
import {
  getEntity, getBeats, getRelations, getEntities, getFloors,
  BEAT_LABELS, KIND_LABELS,
} from '../../lib/content';

const { id } = Astro.params;
const entity = id ? await getEntity(id) : null;
if (!entity) return Astro.redirect('/who', 302);

const prefs = readPrefs(Astro.cookies);
const gate = gateFor(prefs, prefs.spoilers, prefs.fresh);

/* An entity the reader has not met yet is not rendered as a redacted page —
   the URL itself would confirm the name. Send them back to the index. */
if (!reveals(gate, entity.revealedAt)) return Astro.redirect('/who', 302);

const [beats, relations, all, floors] = await Promise.all([
  getBeats(entity.id), getRelations(entity.id), getEntities(), getFloors(),
]);
const nameById = new Map(all.map(e => [e.id, e]));
const floorById = new Map(floors.map(f => [f.id, f]));

/* Usage logs read better as their own block: "where is this used, and when" is
   a different question from "what happened to this character". */
const uses = beats.filter(b => b.kind === 'use');
const story = beats.filter(b => b.kind !== 'use');
const visibleRelations = relations.filter(r => gate.frontier >= r.sortKey);
const hiddenRelations = relations.length - visibleRelations.length;
---
<Layout title={entity.name}>
  <article class="wrap">
    <header class="hero">
      <p class="eyebrow">{KIND_LABELS[entity.kind]} · {entity.role}</p>
      <h1>{entity.name}</h1>
      <p class="tagline">{entity.tagline}</p>
      {entity.aka.length > 0 && (
        <p class="aka">Also known as {(entity.aka as string[]).join(', ')}</p>
      )}
    </header>

    <div class="cols">
      <div class="main">
        {uses.length > 0 && (
          <section>
            <h2>Where it's used</h2>
            <ol class="log">
              {uses.map(b => {
                const open = reveals(gate, b.at);
                const floor = b.floor ? floorById.get(b.floor) : null;
                return (
                  <li class="entry">
                    <div class="stamp">
                      <span class="bk">Bk {b.book}{b.chapter ? `·${b.chapter}` : ''}</span>
                      {floor && (
                        <span class="fl" style={`--dot: var(${floor.accent})`}>
                          Floor {floor.id}{open ? ` — ${floor.name}` : ''}
                        </span>
                      )}
                    </div>
                    {open ? (
                      <div class="entry-body">
                        <h3>{b.headline}</h3>
                        <p>{b.text}</p>
                        {b.confidence === 'draft' && <span class="draft">unverified</span>}
                      </div>
                    ) : <Sealed at={b.at} compact />}
                  </li>
                );
              })}
            </ol>
          </section>
        )}

        {story.length > 0 && (
          <section>
            <h2>{entity.kind === 'character' ? 'Arc' : 'History'}</h2>
            <ol class="log">
              {story.map(b => {
                const open = reveals(gate, b.at);
                const floor = b.floor ? floorById.get(b.floor) : null;
                return (
                  <li class="entry">
                    <div class="stamp">
                      <span class="bk">Bk {b.book}{b.chapter ? `·${b.chapter}` : ''}</span>
                      <span class="kind">{BEAT_LABELS[b.kind] ?? b.kind}</span>
                      {floor && (
                        <span class="fl" style={`--dot: var(${floor.accent})`}>
                          Floor {floor.id}{open ? ` — ${floor.name}` : ''}
                        </span>
                      )}
                    </div>
                    {open ? (
                      <div class="entry-body">
                        <h3>{b.headline}</h3>
                        <p>{b.text}</p>
                        {b.confidence === 'draft' && <span class="draft">unverified</span>}
                      </div>
                    ) : <Sealed at={b.at} compact />}
                  </li>
                );
              })}
            </ol>
          </section>
        )}
      </div>

      <aside>
        <h2>Connections</h2>
        {visibleRelations.length === 0 && hiddenRelations === 0 && (
          <p class="none">Nothing recorded yet.</p>
        )}
        <ul class="rels">
          {visibleRelations.map(r => {
            const other = nameById.get(r.otherId);
            if (!other) return null;
            return (
              <li>
                <span class="rel-kind">{r.kind.replace(/-/g, ' ')}</span>
                <a href={`/entity/${other.id}`}>{other.name}</a>
                {r.note && <p class="rel-note">{r.note}</p>}
              </li>
            );
          })}
        </ul>
        {hiddenRelations > 0 && (
          <p class="sealed" style="padding:9px 12px">
            <b>*** {hiddenRelations} sealed ***</b>Read further to see who else this touches.
          </p>
        )}
        <p class="back"><a href="/who">← All entries</a></p>
      </aside>
    </div>
  </article>
</Layout>

<style>
  .hero { padding-block: 44px 26px; border-bottom: 1px solid var(--color-line); }
  h1 { font-size: clamp(38px, 7vw, 68px); font-weight: 800; margin: 10px 0 0; }
  .tagline { font-size: 17px; color: var(--color-grey-200); max-width: var(--measure); margin: 14px 0 0; }
  .aka { font-family: var(--font-mono); font-size: 12px; color: var(--color-grey-500); margin: 10px 0 0; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 40px; padding-top: 34px; align-items: start; }
  @media (max-width: 820px) { .cols { grid-template-columns: 1fr; gap: 28px; } }
  h2 { font-size: 22px; font-weight: 700; color: var(--color-gold); margin-bottom: 14px; }
  section + section { margin-top: 38px; }
  .log { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px;
         background: var(--color-line); border: 1px solid var(--color-line); }
  .entry { background: var(--color-panel); padding: 16px 18px; }
  .stamp { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; margin-bottom: 9px;
           font-family: var(--font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; }
  .bk { color: #0e0e0e; background: var(--color-grey-300); padding: 2px 6px; font-weight: 700; }
  .kind { color: var(--color-grey-500); }
  .fl { color: var(--color-grey-300); display: inline-flex; align-items: center; gap: 6px; }
  .fl::before { content: ''; width: 8px; height: 8px; background: var(--dot); flex: none; }
  .entry-body h3 { font-size: 19px; font-weight: 700; color: #fff; }
  .entry-body p { margin: 6px 0 0; font-size: 15px; color: var(--color-grey-200); max-width: var(--measure); }
  .draft { display: inline-block; margin-top: 9px; font-family: var(--font-mono); font-size: 10px;
           letter-spacing: .14em; text-transform: uppercase; color: var(--color-grey-700);
           border: 1px solid var(--color-line); padding: 2px 6px; }
  .rels { list-style: none; margin: 0 0 14px; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .rel-kind { display: block; font-family: var(--font-mono); font-size: 10px; letter-spacing: .14em;
              text-transform: uppercase; color: var(--color-grey-500); }
  .rel-note { font-size: 13px; color: var(--color-grey-500); margin: 3px 0 0; }
  .none { color: var(--color-grey-500); font-size: 14px; }
  .back { margin-top: 20px; font-family: var(--font-mono); font-size: 12px; }
</style>
