---
import Layout from '../../layouts/Layout.astro';
import Sealed from '../../components/Sealed.astro';
import BeatEntry from '../../components/BeatEntry.astro';
import { reveals } from '../../lib/spoiler';
import { aliasesSeen } from '../../lib/aliases';
import {
  getEntity, getBeats, getRelations, getEntities, getFloors,
  KIND_LABELS, readGate, taglineFor, descriptionFor,
} from '../../lib/content';

const { id } = Astro.params;
const entity = id ? await getEntity(id) : null;
if (!entity) return Astro.redirect('/who', 302);

const { gate } = await readGate(Astro.cookies);

/* An entity the reader has not met yet is not rendered as a redacted page —
   the URL itself would confirm the name. Send them back to the index. */
if (!reveals(gate, entity.revealedAt)) return Astro.redirect('/who', 302);

const [beats, relations, all, floors] = await Promise.all([
  getBeats(entity.id), getRelations(entity.id), getEntities(), getFloors(),
]);
// Only the aliases already reached: some are printed chapters after the entity.
const aka = aliasesSeen(entity, gate);
const nameById = new Map(all.map(e => [e.id, e]));
const floorById = new Map(floors.map(f => [f.id, f]));

/* Usage logs read better as their own block — for a thing. "Where is this used,
   and when" is a question about an item or a mechanic. A character's `use`
   beats are that character using something, which is part of their story, and
   splitting them out put a "Where it's used" heading above Carl's own life. */
const usable = entity.kind === 'item' || entity.kind === 'mechanic';
const uses = usable ? beats.filter(b => b.kind === 'use') : [];
const story = usable ? beats.filter(b => b.kind !== 'use') : beats;

/* Beats arrive sorted by sortKey, so everything still sealed sits at the end.
   They collapse into a single line rather than a stack of stamped placeholders:
   a sealed entry reading "Bk 7 · Fate · Floor 9" tells you the character dies
   on the ninth floor without opening anything, and four of them tells you how
   the rest of their story is shaped. The count and the next unlock point are
   all a reader needs to know there is more coming. */
const split = (rows: typeof beats) => {
  const shown = rows.filter(b => gate.frontier >= b.sortKey);
  const hidden = rows.filter(b => gate.frontier < b.sortKey);
  return { shown, hidden, nextAt: hidden.length ? Math.min(...hidden.map(b => b.sortKey)) : null };
};
const useLog = split(uses);
const storyLog = split(story);

/* A long life can be read one book at a time. The chips filter rather than
   jump: `?book=3` is resolved here, so a reload, a shared link and a reader
   with no JavaScript all land on book 3 alone; the script only saves the page
   load. Only books with an entry the reader has reached get a chip, and every
   count is of reached entries — the same rule as /who's counts. */
const shownAll = [...useLog.shown, ...storyLog.shown];
const bookCounts = new Map<number, number>();
for (const b of shownAll) bookCounts.set(b.book, (bookCounts.get(b.book) ?? 0) + 1);
const bookList = [...bookCounts.keys()].sort((a, b) => a - b);
const filterable = shownAll.length > 12 && bookList.length > 1;
const asked = Number(Astro.url.searchParams.get('book'));
const pick = filterable && bookCounts.has(asked) ? asked : 0;
const off = (b: { book: number }) => pick !== 0 && b.book !== pick;
const useOn = useLog.shown.some(b => !off(b));
const storyOn = storyLog.shown.some(b => !off(b));

const visibleRelations = relations.filter(r => gate.frontier >= r.sortKey);
const hiddenRelations = relations.length - visibleRelations.length;

/* The return trip to /when. It is offered only when there is a line waiting
   there: `lanesFor` draws an entry that is revealed *and* has at least one beat
   the reader has reached, and this page already guarantees the first half. Send
   someone whose entries are all still sealed and they arrive at a chart with
   nothing selected, which is a dead end wearing a button. */
const onTimeline = beats.some(b => gate.frontier >= b.sortKey);

const description = descriptionFor(entity, gate);
/* Source tags read "1:5"; the stamp shows "Bk 1 · 5", or just the book for an
   end-of-book tag. */
const stampOf = (tag: string) => {
  const [book, chapter] = tag.split(':');
  return chapter && chapter !== 'end' ? `Book ${book} · Ch ${chapter}` : `Book ${book}`;
};
---
<Layout title={entity.name}>
  <article class="wrap">
    <header class="hero">
      <p class="eyebrow">{KIND_LABELS[entity.kind]} · {entity.role}</p>
      <h1>{entity.name}</h1>
      <p class={`tagline${entity.voice === 'self' ? ' spoken' : ''}`}>{taglineFor(entity, gate)}</p>
      {aka.length > 0 && <p class="aka">Also known as {aka.join(', ')}</p>}
      {onTimeline && (
        <p class="totime wide-only">
          <a class="btn btn-go" href={`/when?view=braid&id=${entity.id}`}
             >See {entity.name} on the timeline →</a>
        </p>
      )}
    </header>

    <div class="cols">
      <div class="main">
        {description && (
          <section>
            <div class="sys">
              <b>*** Description ***</b>{description.text}
              <span class="src">{stampOf(description.source)}</span>
            </div>
          </section>
        )}

        {filterable && (
          <nav class="booknav" aria-label="Show one book">
            <a href={Astro.url.pathname} class="chip-btn" data-book="0" aria-pressed={pick === 0 ? 'true' : 'false'}>
              All books <span class="n">{shownAll.length}</span>
            </a>
            {bookList.map(book => (
              <a href={`${Astro.url.pathname}?book=${book}`} class="chip-btn" data-book={book}
                 aria-pressed={pick === book ? 'true' : 'false'}>
                Book {book} <span class="n">{bookCounts.get(book)}</span>
              </a>
            ))}
          </nav>
        )}

        {uses.length > 0 && (
          <section data-log hidden={pick !== 0 && !useOn}>
            <h2 class="sect">Where it's used</h2>
            <ol class="log">
              {useLog.shown.map(b => (
                <BeatEntry beat={b} id={`b${b.id}`} floor={b.floor ? floorById.get(b.floor) : null} hidden={off(b)} />
              ))}
              {useLog.hidden.length > 0 && (
                <li class="entry more" hidden={pick !== 0}>
                  <Sealed at={useLog.nextAt!} compact
                          count={useLog.hidden.length} noun="use" />
                </li>
              )}
            </ol>
          </section>
        )}

        {story.length > 0 && (
          <section data-log hidden={pick !== 0 && !storyOn}>
            <h2 class="sect">{entity.kind === 'character' ? 'Story so far' : 'History'}</h2>
            <ol class="log">
              {storyLog.shown.map(b => (
                <BeatEntry beat={b} id={`b${b.id}`} floor={b.floor ? floorById.get(b.floor) : null} hidden={off(b)} />
              ))}
              {storyLog.hidden.length > 0 && (
                <li class="entry more" hidden={pick !== 0}>
                  <Sealed at={storyLog.nextAt!} compact
                          count={storyLog.hidden.length} noun="entry" />
                </li>
              )}
            </ol>
          </section>
        )}
      </div>

      <aside>
        <h2 class="sect">Connections</h2>
        {visibleRelations.length === 0 && hiddenRelations === 0 && (
          <p class="none">Nothing recorded yet.</p>
        )}
        <ul class="rels">
          {visibleRelations.map(r => {
            const other = nameById.get(r.otherId);
            if (!other) return null;
            return (
              <li>
                <span class="rel-kind">{r.kind.replace(/-/g, ' ')}</span>
                <a href={`/entity/${other.id}`}>{other.name}</a>
                {r.note && <p class="rel-note">{r.note}</p>}
              </li>
            );
          })}
        </ul>
        {hiddenRelations > 0 && (
          <p class="sealed" style="padding:9px 12px">
            <b>*** {hiddenRelations} sealed ***</b>Read further to see who else this touches.
          </p>
        )}
        <p class="back"><a href="/who">← All entries</a></p>
      </aside>
    </div>
  </article>
</Layout>

<style>
  /* The book filter: one chip per book with an entry the reader has reached.
     `hidden` has to win over the component layer's `display` on a row. */
  .booknav { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 26px; }
  :global(.log .entry[hidden]), section[hidden] { display: none !important; }
  /* Beat rows, the log and the relation list are in the shared component layer
     (src/styles/global.css), because /when renders the same objects. */
  .hero { padding-block: 44px 26px; border-bottom: 1px solid var(--color-line); }
  h1 { font-size: clamp(38px, 7vw, 68px); font-weight: 800; margin: 10px 0 0; }
  .tagline { font-size: 17px; color: var(--color-grey-200); max-width: var(--measure); margin: 14px 0 0; }
  .aka { font-family: var(--font-mono); font-size: 12px; color: var(--color-grey-500); margin: 10px 0 0; }
  /* .btn-go carries the look; only the rhythm is this page's business. */
  .totime { margin: 22px 0 0; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 40px; padding-top: 34px; align-items: start; }
  @media (max-width: 820px) { .cols { grid-template-columns: 1fr; gap: 28px; } }
  /* Size, weight and colour come from .sect in the component layer, which the
     /when panel and downstream use for the same object. */
  h2 { margin-bottom: 14px; }
  section + section { margin-top: 38px; }
  .none { color: var(--color-grey-500); font-size: 14px; }
  .back { margin-top: 20px; font-family: var(--font-mono); font-size: 12px; }
</style>

<script>
  /* The chips are real links resolved on the server; this only saves the page
     load. Only a plain left-click is intercepted, and the address write is a
     convenience that may fail without consequence. */
  function show(book: number) {
    document.querySelectorAll<HTMLElement>('.booknav [data-book]').forEach(a =>
      a.setAttribute('aria-pressed', String(Number(a.dataset.book) === book)));
    document.querySelectorAll<HTMLElement>('section[data-log]').forEach(sec => {
      let any = false;
      sec.querySelectorAll<HTMLElement>('.log .entry[data-book]').forEach(li => {
        const on = !book || Number(li.dataset.book) === book;
        li.hidden = !on; any ||= on;
      });
      sec.querySelectorAll<HTMLElement>('.log .entry.more').forEach(li => { li.hidden = book !== 0; });
      sec.hidden = !any && book !== 0;
    });
  }
  document.addEventListener('click', e => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('.booknav a[data-book]');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
    e.preventDefault();
    show(Number(a.dataset.book));
    try { history.replaceState(null, '', a.href); } catch { /* the view is already right */ }
  });

  /* A quick-find hit in the story lands on its own line (#b123). If a book
     filter is hiding that line, the explicit request wins over the filter; the
     line is then brought to the middle of the view and marked, so it is found
     at a glance rather than by reading down from the top. */
  function reveal() {
    const li = location.hash.length > 1 ? document.getElementById(location.hash.slice(1)) : null;
    if (!li || !li.classList.contains('entry')) return;
    if (li.hidden || li.closest('section[hidden]')) {
      show(0);
      try { history.replaceState(null, '', location.pathname + location.hash); } catch { /* shown either way */ }
    }
    document.querySelectorAll('.log .entry.is-hit').forEach(x => x.classList.remove('is-hit'));
    li.classList.add('is-hit');
    li.tabIndex = -1;
    li.focus({ preventScroll: true });
    li.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }
  reveal();
  addEventListener('hashchange', reveal);
</script>
