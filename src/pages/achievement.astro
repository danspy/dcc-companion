---
/* Achievements.

   The reader types what they have just done; the System grants them an
   achievement for it. The gate applies here exactly as everywhere else — the
   System is handed only what the reader has already met, and `src/lib/leak.ts`
   screens the reply — but the text itself is composed at request time, so no
   lint has ever seen it. That is why the screen exists.

   Both routes in are a POST to this page: the plain form, and the script's
   fetch of the same HTML. One render path, and the page works with no
   JavaScript at all — the trophy case is the only part that needs it, and it
   is the only part that is nobody's loss without it. */
import Layout from '../layouts/Layout.astro';
import AchievementCard from '../components/AchievementCard.astro';
import { readGate, getEntities, getFloors, getAchievements } from '../lib/content';
import { describeAt, parseAt } from '../lib/spoiler';
import { MAX_DEED, type Grant } from '../lib/achievement';
import { fileReport } from '../lib/report';
import { BOX_TIERS, tierOf, findRe, keeps } from '../lib/awards';

const { gate } = await readGate(Astro.cookies);

let grant: Grant | null = null;
let deed = '';
let problem: { head: string; body: string } | null = null;

/* The desk has two doors, this form and the app's JSON endpoint, and both go
   through `fileReport`: one limiter, one prompt, one screen. */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  ({ deed, grant, problem } = await fileReport({
    deed: String(form.get('deed') ?? ''),
    surprise: form.get('surprise') != null,
    gate,
    ip: Astro.clientAddress ?? 'unknown',
  }));
}

/* The awards the System actually handed out. Gated on sortKey like every other
   row here, and the sealed ones collapse to a single line rather than a stack
   of stamped placeholders: an award's *name* is the spoiler, and four redacted
   rows with "Floor 9" on them tell you the shape of the rest of the book. */
const [awards, floorRows, allEntities] = await Promise.all([
  getAchievements(), getFloors(), getEntities(),
]);
const floorAccent = new Map(floorRows.map(f => [f.id, f.accent]));
const nameOf = new Map(allEntities.map(e => [e.id, e.name]));

/* The tail must stay the sealed ones whatever the reader sorts by, so the
   sealed count and the "next when you reach…" line are always computed from
   the gate's own order, never from the displayed one. */
const reachedAll = awards.filter(a => gate.frontier >= a.sortKey);
const nextSealed = awards.find(a => gate.frontier < a.sortKey);

/* Sorting is a real link and the order is rendered on the server, the same rule
   /when's filter follows: a reload, a shared link or a reader with no
   JavaScript are all real navigations, and an order held only in a variable is
   thrown away by them. */
/* "When" groups by floor; the rest are flat. There is no separate "Floor"
   sort because that is what "When" already is — see the banding below. */
const SORTS = [
  { key: 'when', label: 'In order' },
  { key: 'recent', label: 'Latest' },
  { key: 'name', label: 'Name' },
  { key: 'box', label: 'Box' },
] as const;
const BOX_RANK = ['bronze', 'silver', 'gold', 'platinum', 'legendary', 'celestial'];
const boxRank = (box: string | null) => {
  const i = BOX_RANK.findIndex(t => box && new RegExp(`\\b${t}\\b`, 'i').test(box));
  return i === -1 ? BOX_RANK.length : i;
};

/* The filter is read on the server and the rows arrive already stamped, the
   same rule /when's filter follows: a reload, a shared link or a reader with no
   JavaScript are all real navigations, and a filter applied only by a script
   paints every row first. */
const q = (Astro.url.searchParams.get('q') ?? '').slice(0, 60);
const askedTiers = new Set(
  (Astro.url.searchParams.get('box') ?? '').split(',').filter(t => BOX_TIERS.includes(t as never)),
);
const re = findRe(q);

const askedSort = Astro.url.searchParams.get('sort') ?? 'when';
const sort = SORTS.some(s => s.key === askedSort) ? askedSort : 'when';

/* Order by when it HAPPENED, not by when it unseals.
   
   These are two different numbers for eleven awards: `sortKey` is pushed later
   when an award names somebody the reader has not met, so it waits for them.
   Sorting by that while stamping the row with its own tag put a floor-1 award
   in the middle of the floor-2 ones and read as a broken timeline, which is
   exactly what it was.
   
   Sorting `reached` chronologically leaks nothing, because every row in it is
   already visible — the gate has been applied. The sealed tail below is still
   counted from `sortKey`, which is the number that decides what is sealed. */
const atKey = (a: { at: string }) => parseAt(a.at);

const reached = [...reachedAll].sort((a, b) => {
  switch (sort) {
    case 'recent': return atKey(b) - atKey(a) || a.name.localeCompare(b.name);
    case 'name': return a.name.localeCompare(b.name);
    case 'box': return boxRank(a.box) - boxRank(b.box) || atKey(a) - atKey(b);
    /* Floor first, then chronological inside it. The two numbers genuinely
       disagree for 42 awards, almost all by one floor and always in the same
       direction: the award is earned at the close of a floor and written about
       in the chapter the next one opens. The page's floor is right about
       *where*, the citation is right about *when*, and a flat chronological
       list makes that look like a shuffled deck. Banding by floor shows both. */
    default: return (a.floor ?? 99) - (b.floor ?? 99) || atKey(a) - atKey(b)
      || a.name.localeCompare(b.name);
  }
});

/* Searchable text per row, built once. Recipients are resolved to names here
   so a reader can search "Donut" and find what she earned. */
const rowsFor = new Map(reached.map(a => {
  const who = ((a.recipients ?? []) as string[]).map(id => nameOf.get(id) ?? id).join(' ');
  return [a.id, {
    find: `${a.name} ${a.forWhat ?? ''} ${a.text} ${a.reward ?? ''} ${who}`.toLowerCase(),
    tier: tierOf(a.box),
  }];
}));
const shown = reached.filter(a => keeps(rowsFor.get(a.id)!, re, askedTiers));
const shownIds = new Set(shown.map(a => a.id));

/* The floor each award opens a new band on, when the list is banded. A band
   with nothing visible under it is hidden, or a filter leaves a heading
   standing over an empty stretch. */
/* "When" is grouped into one collapsible section per floor; every other sort is
   a flat list. `<details>` again rather than a button and an aria-expanded pair
   — the browser already knows how to do this, and so does Find in Page. */
const banded = sort === 'when';
const floorName = new Map(floorRows.map(f => [f.id, f.name]));
const floorInk = new Map(floorRows.map(f => [f.id, f.ink]));

interface Band { floor: number; awards: typeof reached; shown: number }
const bands: Band[] = [];
if (banded) {
  for (const a of reached) {
    const f = a.floor ?? 0;
    let band = bands.at(-1);
    if (!band || band.floor !== f) { band = { floor: f, awards: [], shown: 0 }; bands.push(band); }
    band.awards.push(a);
    if (shownIds.has(a.id)) band.shown++;
  }
}

/* Every count is of awards the reader has reached. A chip reading "Celestial 9"
   on a book-1 page would say how many are still coming, which is the structural
   leak the sealed beat stamps were. */
const tierCounts = new Map(BOX_TIERS.map(t => [t, reached.filter(a => tierOf(a.box) === t).length]));

/** Carries the whole of the reader's setup on every link that reloads this page. */
const withParams = (over: Record<string, string>) => {
  const p = new URLSearchParams();
  const next = { sort, q, box: [...askedTiers].join(','), ...over };
  for (const [k, v] of Object.entries(next)) if (v && !(k === 'sort' && v === 'when')) p.set(k, v);
  const s = p.toString();
  return `/achievement${s ? `?${s}` : ''}#onrecord`;
};

/** "1:2" -> { book: 1, chapter: 2 }. `:end` and a bare book have no chapter. */
function whenOf(at: string) {
  const [b, c] = String(at).split(':');
  const chapter = c === 'end' || c === undefined || c === '0' ? null : Number(c);
  return { book: Number(b), chapter: Number.isFinite(chapter as number) ? chapter : null, end: c === 'end' };
}

const canUseLore = !gate.fresh || !gate.spoilers;
---
<Layout title="Achievements">
  <section class="wrap page">
    <p class="eyebrow" style="color:var(--color-blood)">Awards and Boxes</p>
    <h1>Achievements<span class="beta">Beta</span></h1>
    <p class="standfirst">
      Report your own conduct and the System will decide what it was worth. It is watching
      anyway; you may as well be credited.
    </p>

    <form class="finder deed" method="POST" action="/achievement">
      <div class="finder-row">
        <label class="finder-search">
          <span class="vh">What have you done, crawler?</span>
          <input
            type="text" name="deed" id="deed" autocomplete="off"
            maxlength={MAX_DEED} required value={deed}
            placeholder="burned the lasagna and blamed the dog" />
        </label>
        <button class="btn" type="submit" id="file">File report</button>
        {/* formnovalidate, or the required input blocks a submit that is about
            to be given a deed by the server anyway. */}
        <button class="chip-btn surprise" type="submit" name="surprise" value="1"
                id="surprise" formnovalidate>Surprise me</button>
      </div>
      <p class="finder-note">
        {canUseLore
          ? 'The System knows the crawl as far as you have read it, and not one chapter further.'
          : 'You have not told the dungeon where you are, so the System is working from the ' +
            'premise alone. Name your book in the bar above and it starts using what you have met.'}
      </p>
    </form>

    <div id="grant" class="grantwrap">
      {grant
        ? <AchievementCard grant={grant} deed={deed} />
        : problem
          ? <p class="sys problem"><b>*** {problem.head} ***</b>{problem.body}</p>
          : <p class="sys awaiting"><b>*** Awaiting report ***</b>Describe one thing you have
              done. Be specific. Vagueness is its own achievement and it is not a good one.</p>}
    </div>

    <section id="case" class="trophies" hidden>
      <div class="case-head">
        <h2 class="sect">Earned previously</h2>
        <button class="chip-btn" type="button" id="clearcase">Clear</button>
      </div>
      <ol class="caselist" id="caselist"></ol>
      <p class="case-note label">Kept in this browser only. Nothing you file is stored on the server.</p>
    </section>

    <section class="onrecord" id="onrecord">
      <div class="case-head">
        <h2 class="sect">On record</h2>
        {reached.length > 0 && <span class="tally label">{reached.length} reached</span>}
      </div>
      <p class="rec-note">Awards the System has handed out, in its own words. These open as
        your position catches up — the name of an award is a spoiler on its own.</p>

      {reached.length > 1 && (
        <div class="finder recfinder" id="recfinder">
          <div class="finder-row">
            <label class="finder-search">
              <span class="vh">Search the awards</span>
              <input type="search" id="recq" name="q" value={q} autocomplete="off"
                     placeholder="Search awards or earners" />
              <kbd>/</kbd>
            </label>
            <span class="tally label" id="rectally" data-reached={reached.length}>
              {shown.length} of {reached.length} shown
            </span>
          </div>
          <div class="finder-row">
            <div class="finder-chips">
              {BOX_TIERS.map(t => (
                <a class="chip-btn" data-tier={t}
                   href={withParams({ box: (askedTiers.has(t)
                     ? [...askedTiers].filter(x => x !== t)
                     : [...askedTiers, t]).join(',') })}
                   aria-pressed={askedTiers.has(t) ? 'true' : 'false'}>
                  {t} <span class="n">{tierCounts.get(t)}</span>
                </a>
              ))}
            </div>
            <nav class="switch recsort push-end" aria-label="Sort the awards">
              <span class="label">Sort</span>
              {SORTS.map(o => (
                <a href={withParams({ sort: o.key })}
                   aria-current={o.key === sort ? 'true' : undefined}>{o.label}</a>
              ))}
            </nav>
          </div>
        </div>
      )}

      {reached.length === 0
        ? <p class="sys"><b>*** Nothing on record ***</b>You have not reached a single award yet,
            crawler. Tell the dungeon where you are and the file opens.</p>
        : <div class="recbody">
            {banded
              ? bands.map(band => (
                  <details class="floorsec" data-band={band.floor} open hidden={!band.shown || undefined}>
                    <summary class="floorband">
                      <span class="floormark"
                            style={`background:${floorAccent.get(band.floor) ?? 'var(--color-grey-500)'};color:${floorInk.get(band.floor) ?? 'var(--color-ink)'}`}>
                        {String(band.floor).padStart(2, '0')}
                      </span>
                      <span class="floorband-name">{floorName.get(band.floor) ?? 'Floor'}</span>
                      <span class="floorband-n label">{band.awards.length}</span>
                    </summary>
                    <ul class="log">
                      {band.awards.map(a => (
                <li class="entry recrow" data-floor={a.floor ?? ''}
                    hidden={!keeps(rowsFor.get(a.id)!, re, askedTiers) || undefined}
                    data-find={rowsFor.get(a.id)!.find}
                    data-tier={rowsFor.get(a.id)!.tier ?? ''}>
                  <p class="stamp">
                    <span class="bk">Bk {whenOf(a.at).book}{whenOf(a.at).chapter
                      ? ` · Ch ${whenOf(a.at).chapter}` : whenOf(a.at).end ? ' · end' : ''}</span>
                    {a.floor && (
                      <span class="fl" style={`--dot:${floorAccent.get(a.floor) ?? 'var(--color-grey-500)'}`}>
                        Floor {a.floor}
                      </span>
                    )}
                    {a.box && /\bBox\b/i.test(a.box) && <span class="rec-box">{a.box}</span>}
                  </p>
                  <div class="entry-body">
                    <h3>{a.name}</h3>
                    {a.forWhat && <p class="rec-for">For {a.forWhat.replace(/^For\s+/i, '')}</p>}
                    {(a.recipients as string[])?.length > 0 ? (
                      <p class="rec-who">
                        <span class="label">Earned by</span>
                        {(a.recipients as string[]).map((id, i) => (
                          <>{i > 0 && <span class="sep">·</span>}
                          <a href={`/entity/${id}`}>{nameOf.get(id) ?? id}</a></>
                        ))}
                      </p>
                    ) : a.everyone ? (
                      <p class="rec-who"><span class="label">Earned by</span>
                        <span class="rec-anyone">Every crawler</span></p>
                    ) : null}
                    <p class="rec-text">{a.text}</p>
                    {a.reward && <p class="rec-reward"><span class="label">Reward</span>{a.reward}</p>}
                    <p class="rec-src">
                      {a.confidence === 'draft' && <span class="draft">unverified chapter</span>}
                      {a.source && <a class="rec-srclink" href={a.source} rel="noopener nofollow"
                                      target="_blank">Source</a>}
                    </p>
                  </div>
                </li>
                      ))}
                    </ul>
                  </details>
                ))
              : <ul class="log">
                  {reached.map(a => (
                <li class="entry recrow" data-floor={a.floor ?? ''}
                    hidden={!keeps(rowsFor.get(a.id)!, re, askedTiers) || undefined}
                    data-find={rowsFor.get(a.id)!.find}
                    data-tier={rowsFor.get(a.id)!.tier ?? ''}>
                  <p class="stamp">
                    <span class="bk">Bk {whenOf(a.at).book}{whenOf(a.at).chapter
                      ? ` · Ch ${whenOf(a.at).chapter}` : whenOf(a.at).end ? ' · end' : ''}</span>
                    {a.floor && (
                      <span class="fl" style={`--dot:${floorAccent.get(a.floor) ?? 'var(--color-grey-500)'}`}>
                        Floor {a.floor}
                      </span>
                    )}
                    {a.box && /\bBox\b/i.test(a.box) && <span class="rec-box">{a.box}</span>}
                  </p>
                  <div class="entry-body">
                    <h3>{a.name}</h3>
                    {a.forWhat && <p class="rec-for">For {a.forWhat.replace(/^For\s+/i, '')}</p>}
                    {(a.recipients as string[])?.length > 0 ? (
                      <p class="rec-who">
                        <span class="label">Earned by</span>
                        {(a.recipients as string[]).map((id, i) => (
                          <>{i > 0 && <span class="sep">·</span>}
                          <a href={`/entity/${id}`}>{nameOf.get(id) ?? id}</a></>
                        ))}
                      </p>
                    ) : a.everyone ? (
                      <p class="rec-who"><span class="label">Earned by</span>
                        <span class="rec-anyone">Every crawler</span></p>
                    ) : null}
                    <p class="rec-text">{a.text}</p>
                    {a.reward && <p class="rec-reward"><span class="label">Reward</span>{a.reward}</p>}
                    <p class="rec-src">
                      {a.confidence === 'draft' && <span class="draft">unverified chapter</span>}
                      {a.source && <a class="rec-srclink" href={a.source} rel="noopener nofollow"
                                      target="_blank">Source</a>}
                    </p>
                  </div>
                </li>
                  ))}
                </ul>}

            <p class="label recnone" id="recnone" hidden={shown.length > 0 || undefined}>
              Nothing matches that. Clear the search, or pick another box.
            </p>
            {nextSealed && (
              <p class="label recsealed">{awards.length - reachedAll.length} more on record, the next
                when {describeAt(nextSealed.sortKey)}.</p>
            )}
          </div>}
    </section>
  </section>
</Layout>

<style>
  .page { padding-block: 44px 24px; }
  h1 { font-size: clamp(40px, 8vw, 84px); font-weight: 800; letter-spacing: -.01em; margin-top: 12px; }
  /* Blood rather than gold: gold is what the page uses for things that worked.
     Sized off the type scale and lifted onto the cap line by eye — it is a
     label pinned to a 84px word, so it cannot sit on the baseline. */
  h1 .beta {
    font-family: var(--font-mono); font-size: var(--type-ui); font-weight: 700;
    letter-spacing: var(--ls-label); color: var(--color-blood);
    border: 1px solid var(--color-blood); padding: 3px 7px 2px;
    margin-left: 14px; vertical-align: middle; position: relative; top: -.42em;
    white-space: nowrap;
  }
  .standfirst { font-size: var(--type-lede); color: var(--color-grey-200);
                max-width: var(--measure); margin: 18px 0 28px; }
  .deed { padding: 16px; }
  .deed .finder-note { margin-top: 12px; color: var(--color-grey-500); font-size: var(--type-meta); }
  /* The search field is --color-ink because it sits inside a --color-panel box;
     the same reason /who's is. */
  .deed .finder-search { flex: 1 1 320px; }
  .deed .surprise { flex: none; }
  .grantwrap { margin-top: 18px; }
  .problem b { color: var(--color-blood); }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  .trophies { margin-top: 40px; border-top: 1px solid var(--color-line); padding-top: 22px; }
  .case-head { display: flex; align-items: center; gap: 14px; }
  .case-head .sect { margin: 0; }
  .case-head .chip-btn { margin-left: auto; }
  .caselist { list-style: none; margin: 16px 0 0; padding: 0;
              display: flex; flex-direction: column; gap: 1px; background: var(--color-line); }
  .case-note { margin-top: 14px; color: var(--color-grey-700); }

  .onrecord { margin-top: 44px; border-top: 1px solid var(--color-line); padding-top: 22px; }
  .onrecord .tally { margin-left: auto; }
  .rec-note { margin: 10px 0 18px; max-width: var(--measure);
              font-size: var(--type-meta); color: var(--color-grey-500); }
  /* The System's own words, in the System's own face — the same treatment a
     quoted item description gets on an entity page. */
  .rec-text { overflow-wrap: anywhere; font-family: var(--font-mono); font-size: var(--type-meta); line-height: 1.65;
              color: var(--color-grey-200); margin: 10px 0 0; max-width: var(--measure); }
  .rec-for { overflow-wrap: anywhere; margin: 5px 0 0; font-size: var(--type-meta); color: var(--color-grey-500);
             font-style: italic; }
  .rec-reward { overflow-wrap: anywhere; font-family: var(--font-mono); font-size: var(--type-meta);
                color: var(--color-grey-100); margin: 10px 0 0; max-width: var(--measure); }
  .rec-reward .label { display: block; margin-bottom: 2px; }
  .rec-box { color: var(--color-grey-300); }
  .rec-who { margin: 8px 0 0; font-size: var(--type-meta); color: var(--color-grey-300);
             display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; }
  .rec-who .label { flex: none; }
  .rec-who .sep { color: var(--color-grey-700); }
  .recsort { align-items: baseline; gap: 6px; flex-wrap: wrap; }
  .recsort .label { margin-right: 4px; }
  .recfinder { padding: 14px 16px; margin-bottom: 18px; }
  .recfinder .finder-row + .finder-row { margin-top: 12px; }
  .recfinder .finder-search { flex: 1 1 260px; }
  .rec-anyone { color: var(--color-grey-500); font-style: italic; }
  .recempty { margin: 0; }
  .recbody { display: flex; flex-direction: column; gap: 10px; }
  .floorsec { border: 1px solid var(--color-line); background: var(--color-panel); }
  .floorsec[hidden] { display: none; }
  /* A floor's number on its book's colour — the same mark / and /when use. The
     default triangle goes the same way the trophy case's does. */
  .floorband { display: flex; align-items: center; gap: 12px; cursor: pointer;
               list-style: none; padding: 12px 14px; }
  .floorband::-webkit-details-marker { display: none; }
  .floorband:hover { background: var(--color-raised); }
  .floorband-name { font-family: var(--font-display); text-transform: uppercase;
                    font-weight: 700; font-size: var(--type-sect); color: var(--color-grey-100);
                    min-width: 0; overflow-wrap: anywhere; }
  .floorband-n { margin-left: auto; color: var(--color-grey-500); flex: none; }
  .floorband::after { content: '+'; font-family: var(--font-mono); color: var(--color-grey-700);
                      flex: none; line-height: 1; }
  .floorsec[open] > .floorband::after { content: '\2212'; }
  .floorsec[open] > .floorband { border-bottom: 1px solid var(--color-line); }
  /* Only the outer border is dropped — the section already draws one. The
     background must stay: `.log` paints `--color-line` behind a 1px gap, and
     those gaps ARE the divider lines between awards. Setting it transparent
     here silently deleted every rule in the list. */
  .floorsec .log { border: 0; }
  .recnone, .recsealed { margin: 0; padding: 12px 14px; background: var(--color-panel);
                         border: 1px solid var(--color-line); }
  .rec-src { display: flex; align-items: center; gap: 12px; margin: 12px 0 0; }
  .rec-srclink { font-family: var(--font-mono); font-size: var(--type-label);
                 letter-spacing: var(--ls-label); text-transform: uppercase;
                 color: var(--color-grey-500); }
  .rec-srclink:hover { color: var(--color-gold); }
  /* One filed award: the tier, what it was called, and what you claimed to
     have done. The citation and reward hang off the title attribute — the case
     is an index, and the card above is where a grant is read.

     `:global` is load-bearing. These rows are built by the script, so they
     never carry the scope attribute Astro stamps on elements written in this
     template, and a scoped rule misses them entirely — the row renders as run
     together text with no gap, no padding and the wrong face. Scoped styling
     only reaches markup the page actually wrote. */
  :global(.caseitem) {
    background: var(--color-panel); border-left: 3px solid var(--tier);
    font-size: var(--type-meta); min-width: 0;
  }
  /* The row itself. `list-style: none` plus the WebKit pseudo-element is what
     removes the default triangle; the chevron below is drawn instead so it can
     sit on the right and turn. */
  :global(.casesum) {
    display: flex; align-items: baseline; gap: 12px; padding: 9px 12px;
    cursor: pointer; list-style: none; min-width: 0;
  }
  :global(.casesum)::-webkit-details-marker { display: none; }
  :global(.casesum):hover { background: var(--color-raised); }
  :global(.casesum)::after {
    content: '+'; font-family: var(--font-mono); color: var(--color-grey-700);
    flex: none; margin-left: 4px; line-height: 1;
  }
  :global(.casedet[open]) > :global(.casesum)::after { content: '−'; }
  :global(.casedet[open]) > :global(.casesum) { background: var(--color-raised); }
  :global(.casebox) {
    font-family: var(--font-mono); font-size: var(--type-label); font-weight: 700;
    letter-spacing: var(--ls-label); text-transform: uppercase;
    padding: 2px 7px; flex: none;
  }
  :global(.casename) { overflow-wrap: anywhere; color: #fff; font-weight: 600; flex: none; }
  :global(.casedeed) { overflow-wrap: anywhere; color: var(--color-grey-500); font-style: italic; margin-left: auto;
              white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  /* Opened: the citation in the System's own face, as the card shows it. */
  :global(.casebody) { padding: 2px 12px 14px 12px; border-top: 1px solid var(--color-line-soft); }
  :global(.casecite) { overflow-wrap: anywhere;
    font-family: var(--font-mono); font-size: var(--type-meta); line-height: 1.65;
    color: var(--color-grey-200); margin: 12px 0 0; max-width: var(--measure);
  }
  :global(.casereward) { overflow-wrap: anywhere;
    font-family: var(--font-mono); font-size: var(--type-meta);
    color: var(--color-grey-100); margin: 12px 0 0;
  }
  :global(.casereward) :global(.label) { display: block; margin-bottom: 2px; }
  @media (max-width: 620px) {
    :global(.casesum) { flex-wrap: wrap; gap: 6px 10px; }
    :global(.casedeed) { margin-left: 0; flex-basis: 100%; white-space: normal; }
    :global(.casesum)::after { position: absolute; right: 12px; }
    :global(.caseitem) { position: relative; }
  }
</style>

<script>
  /* Progressive enhancement, and nothing more. The form is a real POST to this
     same page and the card is rendered by the server either way; the script
     only saves the reader a page load and keeps a trophy case.

     Two rules this project has already paid for apply here too: only a failed
     fetch may fall back to a navigation (a reload would throw away what the
     reader is looking at, which is worse than the error it insures against),
     and nothing holds a node from inside the fragment that gets swapped. */

  const KEY = 'dcc_trophies';
  const CAP = 12;

  const form = document.querySelector<HTMLFormElement>('form.deed');
  const input = document.querySelector<HTMLInputElement>('#deed');
  const button = document.querySelector<HTMLButtonElement>('#file');
  const caseBox = document.querySelector<HTMLElement>('#case');
  const caseList = document.querySelector<HTMLOListElement>('#caselist');

  interface Trophy {
    title: string; citation: string; reward: string;
    tier: string; accent: string; ink: string; deed: string;
  }

  const read = (): Trophy[] => {
    try { return JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch { return []; }
  };
  const write = (rows: Trophy[]) => {
    try { localStorage.setItem(KEY, JSON.stringify(rows.slice(0, CAP))); } catch { /* private mode */ }
  };

  /* The case is an index that opens: the closed row is the tier, the name and
     what you claimed to have done, and opening it gives back the citation and
     the reward in full. It was a `title` tooltip first, which is unreachable on
     a phone and unreadable everywhere else.

     `<details>` rather than a button and an `aria-expanded` pair, because the
     browser already knows how to do this — keyboard, screen readers and Find in
     Page included — and these rows are built by a script that should not be
     reimplementing a disclosure widget.

     textContent throughout: this is coming back out of storage and never goes
     anywhere near innerHTML. */
  const span = (cls: string, text: string) => {
    const el = document.createElement('span');
    el.className = cls;
    el.textContent = text;
    return el;
  };

  function renderCase() {
    if (!caseBox || !caseList) return;
    const rows = read();
    caseBox.hidden = rows.length === 0;
    caseList.replaceChildren(...rows.map(t => {
      const li = document.createElement('li');
      li.className = 'caseitem';
      li.style.setProperty('--tier', t.accent);

      const det = document.createElement('details');
      det.className = 'casedet';

      const sum = document.createElement('summary');
      sum.className = 'casesum';
      const box = span('casebox', t.tier);
      box.style.background = t.accent;
      box.style.color = t.ink;
      sum.append(box, span('casename', t.title), span('casedeed', t.deed));

      const body = document.createElement('div');
      body.className = 'casebody';
      const cite = document.createElement('p');
      cite.className = 'casecite';
      cite.textContent = t.citation;
      const reward = document.createElement('p');
      reward.className = 'casereward';
      reward.append(span('label', 'Reward'), document.createTextNode(t.reward));
      body.append(cite, reward);

      det.append(sum, body);
      li.append(det);
      return li;
    }));
  }

  /** Swap in a freshly rendered #grant, and file whatever arrived in it. */
  function adopt(html: string) {
    const doc = new DOMParser().parseFromString(html, 'text/html');
    const next = doc.querySelector('#grant');
    const here = document.querySelector('#grant');
    if (!next || !here) return;
    here.replaceChildren(...Array.from(next.childNodes));

    const card = here.querySelector<HTMLElement>('[data-grant]');
    if (!card?.dataset.grant) return;
    try {
      const filed = JSON.parse(card.dataset.grant) as Trophy;
      /* The server chose the deed when it was a surprise, so the box has to
         catch up with what was actually filed — otherwise the card and the
         field above it disagree, and a second press re-files the old one. */
      if (input && filed.deed) input.value = filed.deed;
      write([filed, ...read()]);
      renderCase();
    } catch { /* a card we cannot file is still a card worth showing */ }
  }

  function working() {
    const here = document.querySelector('#grant');
    if (!here) return;
    const p = document.createElement('p');
    p.className = 'sys';
    const b = document.createElement('b');
    b.textContent = '*** Reviewing footage ***';
    p.append(b, document.createTextNode(
      'Your report is with the department. Nobody there is in a hurry.'));
    here.replaceChildren(p);
  }

  form?.addEventListener('submit', async event => {
    /* Which button was pressed. "Surprise me" has no deed to validate, so the
       empty-box guard must not apply to it. */
    const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
    const surprise = submitter?.name === 'surprise';
    if (!surprise && !input?.value.trim()) return;
    event.preventDefault();
    if (button) button.disabled = true;
    working();

    let html: string | null = null;
    try {
      /* FormData(form) alone drops the submitter's own name/value in some
         browsers, and the server would then see an ordinary empty submit. */
      const body = new FormData(form);
      if (surprise) body.set('surprise', '1');
      const res = await fetch('/achievement', {
        method: 'POST',
        headers: { 'x-requested-with': 'fetch' },
        body,
      });
      html = await res.text();
    } catch {
      /* Only the fetch failing earns a page load. Everything below is DOM work
         and must not be able to trigger one. */
      if (button) button.disabled = false;
      form.submit();
      return;
    }

    adopt(html);
    if (button) button.disabled = false;
    input?.focus();
  });

  document.querySelector('#clearcase')?.addEventListener('click', () => {
    write([]);
    renderCase();
  });

  renderCase();

  /* ---- the award filter -------------------------------------------------
     Pure enhancement: the server has already stamped every row, so this only
     saves a round trip. It imports the same predicate the page used, because
     two copies would let the first paint and the first keystroke disagree.

     Everything stays rendered and is hidden, never omitted — a row that was
     never written could not come back when the box is cleared. */
  const { findRe, keeps } = await import('../lib/awards');

  const recq = document.querySelector<HTMLInputElement>('#recq');
  const tally = document.querySelector<HTMLElement>('#rectally');
  const none = document.querySelector<HTMLElement>('#recnone');
  const chips = [...document.querySelectorAll<HTMLAnchorElement>('.recfinder .chip-btn')];
  const rows = [...document.querySelectorAll<HTMLElement>('.recrow')];
  const sections = [...document.querySelectorAll<HTMLDetailsElement>('.floorsec')];

  function applyAwards() {
    if (!recq) return;
    const re = findRe(recq.value);
    const tiers = new Set(chips.filter(c => c.getAttribute('aria-pressed') === 'true')
      .map(c => c.dataset.tier!));
    let shown = 0;
    const live = new Set<string>();
    for (const row of rows) {
      const ok = keeps({ find: row.dataset.find ?? '', tier: (row.dataset.tier || null) as never }, re, tiers);
      row.hidden = !ok;
      if (ok) { shown++; live.add(row.dataset.floor ?? ''); }
    }
    /* A floor section with nothing left under it is a heading over an empty
       stretch — the server hides those on the first paint and this keeps them
       in step afterwards. A section the reader collapsed stays collapsed; a
       search that finds something inside a collapsed one opens it, or the hit
       is invisible and the tally looks wrong. */
    const filtering = !!re || tiers.size > 0;
    for (const sec of sections) {
      const has = live.has(sec.dataset.band ?? '');
      sec.hidden = !has;
      if (filtering && has) sec.open = true;
    }
    if (none) none.hidden = shown > 0;
    if (tally) tally.textContent = `${shown} of ${tally.dataset.reached} shown`;
  }

  recq?.addEventListener('input', applyAwards);

  /* The chips are real links, so no JavaScript still filters. With it, toggle
     in place and keep the address in step — best-effort, exactly as /when
     learned: the view is already correct, the address bar is a convenience. */
  for (const chip of chips) {
    chip.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      chip.setAttribute('aria-pressed',
        chip.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      applyAwards();
      try { history.replaceState(null, '', chip.href.replace(/#.*$/, '')); } catch { /* quota */ }
    });
  }

  document.addEventListener('keydown', event => {
    if (event.key === '/' && document.activeElement !== recq && document.activeElement !== input) {
      event.preventDefault();
      recq?.focus();
    } else if (event.key === 'Escape' && document.activeElement === recq && recq) {
      recq.value = '';
      applyAwards();
    }
  });
</script>
