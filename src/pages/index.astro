    const FS_DUST = `#version 300 es
      precision highp float;
      in vec4 vC; flat in float vKind; out vec4 o;
      void main() {
        float k = 1.0;
        if (vKind > 0.5) { float d = length(gl_PointCoord - 0.5) * 2.0; k = d < 0.5 ? 1.0 : d < 0.8 ? 0.55 : d < 1.0 ? 0.25 : 0.0; }
