    }
    function stairs(focusDoc: number, offs: number[]) {
      const lo = scrollY - 300, hi = scrollY + innerHeight + 300;
      flights.forEach((f, i) => {
        const n = f.steps.length;
        // built one by one from the floor above, a few already at rest; crumbling top first as that floor collapses
        const u = between(i, focusDoc);
        const on = motion ? Math.round(clamp01((u + 0.18) / 0.6) * n) : n;
        const fall = motion ? Math.round(clamp01((u - 0.5) / 0.47) * n) : 0;
        if (on !== f.on || fall !== f.fall) {
          f.steps.forEach((s, k) => { s.classList.toggle('on', k < on && k >= fall); s.classList.toggle('fall', k < fall); });
          f.on = on; f.fall = fall;
        }
        // the steps follow the two floors they join through the soft hold
        if (!motion || f.bottom < lo || f.top > hi) return;
        const oa = offs[i], ob = offs[i + 1] ?? oa;
