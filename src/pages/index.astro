       the screen a sub-pixel apart, so the picture fades over the canvas
       across the first HAND of the collapse instead of swapping in one frame. */
    const HAND = 0.04;
    const smooth = (a: number, b: number, v: number) => { const t = clamp01((v - a) / (b - a)); return t * t * (3 - 2 * t); };
    const webgl = motion && (() => { try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; } })();
    const arts = [...dungeon.querySelectorAll<HTMLElement>('.art')];
    const cubeData = new Map<HTMLElement, ArrayBuffer | null>();
    function fetchCubes(a: HTMLElement) {
      if (!webgl || cubeData.has(a) || !a.dataset.cubes) return;
      cubeData.set(a, null);
      fetch(a.dataset.cubes, { credentials: 'same-origin' }).then(r => (r.ok ? r.arrayBuffer() : null)).catch(() => null)
        .then(buf => { if (buf) { cubeData.set(a, buf); onScroll(); } });
    }
    const near = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { fetchCubes(e.target as HTMLElement); near.unobserve(e.target); } }), { rootMargin: '1600px 0px' });
