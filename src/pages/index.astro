    const FS_CUBE = `#version 300 es
      precision highp float;
      uniform sampler2D uPic, uId; uniform ivec2 uPad, uPicSize; uniform float uTol;
      in vec3 vFlat; in vec2 vUV; in vec2 vRest; in float vRestZ; in float vA; in float vDark; flat in float vFace; flat in float vCode;
      out vec4 o;
      void main() {
