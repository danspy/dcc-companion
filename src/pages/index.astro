---
import Layout from '../layouts/Layout.astro';
import { reveals } from '../lib/spoiler';
import { getBooks, getFloors, getForetold, getAllBeats, readGate } from '../lib/content';
import { readSince, sinceLabel } from '../lib/since';
import { VOXEL_FLOORS } from '../lib/voxel/floors';
import { pictureFor, showsHero, FALLBACK_ACCENT } from '../lib/voxel/art';
import { stampOf, span } from '../lib/stamps';
import FloorPeek from '../components/FloorPeek.astro';
import StartScreen from '../components/StartScreen.astro';

const { gate } = await readGate(Astro.cookies);
const [books, floors, foretoldRows] = await Promise.all([getBooks(), getFloors(), getForetold()]);
const bookById = new Map(books.map(b => [b.id, b]));
/* What is new since the reader's last move, offered on the floor they stand on (see since.ts). */
const since = readSince(Astro.cookies, gate, b => bookById.get(b)?.chapters ?? null);
const sinceCount = since ? (await getAllBeats()).filter(b => b.sortKey > since.key && b.sortKey <= gate.frontier).length : 0;

/* A floor's story arrives in parts, each unsealed at the end of the stretch
   it tells: the summary rule, applied a few chapters at a time. The build
   resolves every part's `sortKey`; the page only compares. */
interface RecapPart { title: string; text: string; from: string; at: string; sortKey: number }
/* A database seeded before recaps became parts still holds one string; show
   it as a single part rather than nothing (a dev server keeps its seed until
   restarted). */
const partsOf = (floor: { recap: unknown; revealedAt: string; recapAt: string; recapSortKey: number }): RecapPart[] =>
  Array.isArray(floor.recap) ? floor.recap as RecapPart[]
  : typeof floor.recap === 'string' && floor.recap
    ? [{ title: 'What happened', text: floor.recap, from: floor.revealedAt, at: floor.recapAt, sortKey: floor.recapSortKey }]
    : [];


/* The floor the reader stands on: the page opens on it. */
const reached = floors.filter(f => reveals(gate, f.revealedAt));
const current = reached.length ? reached[reached.length - 1].id : null;

/* The top of the page follows the reader. With no book picked it says what
   this site is and gives the back cover; once they have a position it is the
   System's catch-up on everything before the floor they stand on (stored per
   floor, gated with it), and a line saying where they are. */
const mode = gate.spoilers && gate.fresh ? 'welcome' : 'previously';
const positionLabel = (() => {
  if (!gate.spoilers) return 'You are reading with everything shown';
  const book = Math.floor(gate.frontier / 1000), chapter = gate.frontier % 1000;
  return chapter >= 999 || chapter === 0 ? `You have finished book ${book}` : `You are in book ${book}, chapter ${chapter}`;
})();

/* The World Dungeon at a glance: all eighteen floors, each as much as the
   reader has been told. Eighteen is on the back cover, so the count is safe;
   what fills each tile is not. A floor reached shows its diorama and opens its
   guide; a floor only named shows the name, stamped where it was printed; a
   floor further down shows what the books have said about it so far, note by
   note; anything else is sealed. A floor with no picture to show stands as
   the uncharted island (see `unchartedArt`). */
interface Note { at: string; sortKey: number; text: string }
const foretoldById = new Map(foretoldRows.map(f => [f.id, f]));
const atlas = Array.from({ length: 18 }, (_, i) => {
  const id = i + 1;
  const floor = floors.find(f => f.id === id);
  if (floor) {
    const arrived = reveals(gate, floor.revealedAt);
    const named = arrived || (floor.nameAt != null && reveals(gate, floor.nameAt));
    /* The tile's picture opens at the floor's artKey, the point by which
       everything it shows has been read (served by /art/floor-N.png, which
       checks the same thing). */
    const art = !!VOXEL_FLOORS[id] && floor.artKey != null && gate.frontier >= floor.artKey;
    return {
      id, kind: arrived ? 'reached' : named ? 'named' : 'sealed',
      name: named ? floor.name : null,
      stamp: arrived ? null : named && floor.nameAt ? stampOf(floor.nameAt) : null,
      /* Only a floor stood on wears its book's colour: on a sealed or merely
         named tile the colour would say which book it is told in. */
      book: arrived ? bookById.get(floor.book) : undefined,
      accent: arrived ? floor.accent : '#3a3a3a', ink: arrived ? floor.ink : '#ffffff',
      href: arrived || named ? `/floor/${id}` : null,
      current: id === current,
      /* the last stretch of its story the reader has reached */
      latest: arrived ? partsOf(floor).filter(p => gate.frontier >= p.sortKey).at(-1) ?? null : null,
      previously: arrived ? floor.previously ?? floor.premise : null,
      art, notes: [] as Note[],
    };
  }
  const f = foretoldById.get(id);
  const notes = ((f?.notes ?? []) as Note[]).filter(n => gate.frontier >= n.sortKey);
  const named = !!f?.name && f.nameKey != null && gate.frontier >= f.nameKey;
  return {
    id, kind: notes.length || named ? 'foretold' : 'sealed',
    name: named ? f!.name : null, stamp: named && f!.nameAt ? stampOf(f!.nameAt) : null,
    book: undefined, accent: '#3a3a3a', ink: '#ffffff',
    href: notes.length || named ? `/floor/${id}` : null,
    current: false, latest: null, previously: null,
    art: !!VOXEL_FLOORS[id] && f?.artKey != null && gate.frontier >= f.artKey, notes,
  };
});
/* Every floor has a picture: its own once the reader may see it, the
   uncharted island under its question mark otherwise. Each address carries
   the picture's hash, so a redrawn one is a new address; its size lets the
   stairwells land on the picture, and `stair` (only for a finished floor) is
   where its own way down is drawn. */
const arts = new Map(await Promise.all(atlas.map(async t =>
  [t.id, await pictureFor(t.id, t.art ? {
    accent: t.kind === 'reached' ? t.accent : FALLBACK_ACCENT,
    hero: showsHero(t.id, gate.frontier, t.kind === 'reached' ? floors.find(f => f.id === t.id)?.recapSortKey : foretoldById.get(t.id)?.heroKey),
  } : null, t.kind !== 'sealed')] as const)));

/* Voxel debris drifting in the dark around the descent, in three depths that
   scroll at different speeds. Seeded, so it is the same field on every visit.
   Mostly loose stone; near a floor the reader has reached, some of it takes
   that floor's book colour (never a colour of a floor not reached), and a few
   embers glow. */
const debris = (() => {
  let a = 1801;
  const r = () => { a = (a + 0x6d2b79f5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
  const STONE = [['#8a8a90', '#6e6e76', '#53535b'], ['#6b6762', '#55524e', '#3f3d3a'], ['#8a5530', '#6d4426', '#52331d']];
  return [0, 1, 2].map(layer => Array.from({ length: [70, 44, 18][layer] }, () => {
    const y = r(), side = r() < 0.5, x = side ? r() * 0.24 : 0.76 + r() * 0.24;
    const near = atlas[Math.min(17, Math.floor(y * 18))];
    const ember = r() < 0.12, tinted = !ember && near?.kind === 'reached' && r() < 0.3;
    const base = tinted ? near.accent : null, st = STONE[Math.floor(r() * STONE.length)];
    return { x: layer === 0 ? r() : x, y, size: [8, 16, 30][layer] + r() * [6, 12, 22][layer],
             spin: r() * 360, drift: 6 + r() * 8, delay: -r() * 12, ember, faces: base ? [base, base, base] : st, tinted };
  }));
})();

/* A floor picked opens its card; ?floor=N renders it open, so a reload or a
   shared link lands the same way, with no JavaScript at all. */
const peekParam = Number(Astro.url.searchParams.get('floor'));
const peekId = atlas.find(t => t.id === peekParam && t.href)?.id ?? null;
const picked = peekId ? atlas.find(t => t.id === peekId)! : null;
const hudStart = peekId ?? current ?? 0;
const stepTo = (d: -1 | 1) => (peekId ? (d < 0 ? atlas.filter(x => x.href && x.id < peekId).at(-1) : atlas.find(x => x.href && x.id > peekId))?.id ?? null : null);
const pad2 = (n: number) => String(n).padStart(2, '0');

/* The back cover: the only story this page prints to everyone. */
const PILOT = [
  "Seattle, January, three in the morning. A Coast Guard veteran named Carl goes outside in a leather jacket, boxer shorts and his ex-girlfriend's pink Crocs to get her prize-winning Persian, Princess Donut, down from a tree. Ninety seconds later every building on your planet falls down, and everyone inside one is dead. That is not a spoiler. That is the premise.",
  "The Borant Corporation has foreclosed on Earth under Syndicate law, all perfectly legal, and the survivors got a choice: come down into my dungeon, or wait up top for the mining crews. Eighteen floors. Every one of them on a clock. When a clock runs out, that floor collapses with whoever is still standing on it.",
  "Oh, and it is television! Broadcast live, across the galaxy. Ratings buy sponsors, sponsors buy loot, loot buys another floor. Being entertaining is a survival stat. Being boring is a cause of death.",
];
---
<Layout title="Floors">
  {/* A reader who has told us nothing gets the start screen: the way in, and the
      button that opens the position picker. The descent is for a reader with a
      position: with nothing read it is eighteen sealed islands. */}
  {mode === 'welcome' ? <StartScreen pilot={PILOT} /> : <>
  {/* Hide the crawl for the instant it takes the script to put the reader's
      floor in view, so the page never paints at the surface and jumps. A CSS
      fallback reveals it regardless, should the script not run. */}
  <script is:inline>document.documentElement.classList.add('descent-pending'); try { history.scrollRestoration = 'manual'; } catch (e) {}</script>
  <div class="world" id="world">
  <div class="void" aria-hidden="true">
    {debris.map((field, layer) => (
      <div class={`field field-${layer}`} data-depth={[0.25, 0.55, 1.15][layer]}>
        {field.map(d => (
          <span class={`vox${d.ember ? ' vox-ember' : ''}`}
                style={`left:${(d.x * 100).toFixed(2)}%;top:${(d.y * 100).toFixed(2)}%;--s:${d.size.toFixed(1)}px;--r:${d.spin.toFixed(0)}deg;--d:${d.drift.toFixed(1)}s;--dl:${d.delay.toFixed(1)}s`}>
            <svg viewBox="0 0 20 22"><path d="M10 1 19 6 10 11 1 6Z" fill={d.faces[0]} /><path d="M1 6 10 11V21L1 16Z" fill={d.faces[1]} style={d.tinted ? 'filter:brightness(.78)' : undefined} /><path d="M10 11 19 6V16L10 21Z" fill={d.faces[2]} style={d.tinted ? 'filter:brightness(.58)' : undefined} /><path d="M10 1 19 6V16L10 21 1 16V6Z" fill="none" stroke="#120c0c" stroke-width="1" /></svg>
          </span>
        ))}
      </div>
    ))}
  </div>

  <div class={`crawl${peekId ? ' is-detail' : ''}`} id="crawl">
    {/* A floor's card: the System's box widened across the column, the text on
        the left, the floor's own picture on the right, ▲ ▼ ✕ beside it. */}
    <section class="dcard" id="dcard" tabindex="-1" aria-label="Floor details" style={picked ? `--dcard-tile:${picked.accent}` : undefined}>
      <div class="dcard-bg" id="dcardbg" aria-hidden="true"></div>
      <div class="dcard-text" id="dcardtext">{peekId && <FloorPeek id={peekId} />}</div>
      <div class="dcard-art" id="dcardart">{peekId && arts.get(peekId) && (
        <img class="isle-img" src={`/art/floor-${peekId}.png?v=${arts.get(peekId)!.version}`} width={arts.get(peekId)!.width} height={arts.get(peekId)!.height} alt="" />
      )}</div>
      <nav class="dcard-nav" aria-label="Floors">
        <a class="dnav" data-close href="/" aria-label="Back to the crawl" title="Back (Esc)">✕</a>
        <a class={`dnav${peekId && !stepTo(-1) ? ' is-off' : ''}`} data-step="-1" href={stepTo(-1) ? `/?floor=${stepTo(-1)}` : '/'} aria-label="The floor above" title="Up (↑)">▲</a>
        <a class={`dnav${peekId && !stepTo(1) ? ' is-off' : ''}`} data-step="1" href={stepTo(1) ? `/?floor=${stepTo(1)}` : '/'} aria-label="The floor below" title="Down (↓)">▼</a>
      </nav>
    </section>

    {/* The System's box, pinned beside the descent: it speaks of the floor in
        view and changes as each one passes. Every card is gated like the rest
        of the page, and with no JavaScript it shows the reader's own floor. */}
    <aside class="hud" id="hud">
      <div class="hud-title" id="hudtitle">
        <div class="hud-title-in">
          <p class="eyebrow">Dungeon Crawler World · Season: Earth</p>
          <h1>The Crawl<em>So Far</em></h1>
        </div>
      </div>
      <div class="hud-cards" id="hudcards">
        <section class={`hud-card sys${hudStart === 0 ? ' is-shown' : ''}`} data-floor="0">
          {/* (a first visit never reaches the descent: it gets the start screen) */}
                <b>*** The surface ***</b>
                {PILOT.map(t => <p>{t}</p>)}
                <p class="hud-lede">Up top, before the stairs.</p>
        </section>
        {atlas.map(t => (
          <section class={`hud-card sys${hudStart === t.id ? ' is-shown' : ''}`} data-floor={t.id} style={`--tile:${t.accent}`}>
            <header class="hud-head">
              <span class="hud-no" aria-hidden="true">{pad2(t.id)}</span>
              <h2 class={t.name ? undefined : 'unnamed'} style={t.name ? `view-transition-name:floor-name-${t.id}` : undefined}>
                <span class="sr-only">Floor {t.id}: </span>{t.name ?? (t.kind === 'sealed' ? 'Sealed' : 'Not yet named')}</h2>
            </header>
            {t.kind === 'reached'
              ? <>
                  {t.book && <p class="hud-book">Book {t.book.id}, <i>{t.book.title}</i></p>}
                  <b>*** Previously, on Dungeon Crawler World ***</b>
                  <p>{t.previously}</p>
                  {t.latest && <p class="hud-last"><span class="label">{t.current ? 'Where you are' : 'Last stretch'} · {span(t.latest.from, t.latest.at)}</span>{t.latest.title}</p>}
                  {t.current && <p class="status">{positionLabel}.</p>}
                  {t.current && since && sinceCount > 0 && <a class="hud-new" href="/since">New since {sinceLabel(since)}: {sinceCount} {sinceCount === 1 ? 'entry' : 'entries'} →</a>}
                  <a class="hud-go" href={`/floor/${t.id}`} data-peek={t.id}><span class="go-long">Details →</span><span class="go-short">What happened</span></a>
                </>
              : t.kind === 'sealed'
                ? <><b>*** Sealed ***</b><p>That's above your pay grade, crawler.</p></>
                : <>
                    {t.stamp && <p class="hud-book">Named in {t.stamp}</p>}
                    <b>*** Not yet entered ***</b>
                    <p>{t.notes.length > 0 ? t.notes[t.notes.length - 1].text : 'You have heard its name. You have not stood on it.'}</p>
                    {t.href && <a class="hud-go" href={t.href} data-peek={t.id}><span class="go-long">What is known →</span><span class="go-short">What is known</span></a>}
                  </>}
          </section>
        ))}
      </div>
    </aside>

    {/* Where you are: the eighteen floors as a gauge, the one in view lit, the
        reader's own floor marked. Colour only on floors the reader has reached. */}
    <nav class="rail" id="rail" aria-label="Floors">
      {atlas.map(t => (
        <a class={`tick tick-${t.kind}${t.current ? ' is-here' : ''}${hudStart === t.id ? ' in-view' : ''}`} href={t.href ?? `#floor-${t.id}`}
           data-goto={t.id} style={`--tile:${t.accent}`} aria-label={`Floor ${t.id}${t.name ? `, ${t.name}` : ''}${t.current ? ', you are here' : ''}`}>
          <span class="tick-no">{pad2(t.id)}</span><span class="tick-bar"></span>
        </a>
      ))}
      {/* the keys that walk the descent, for a reader with a keyboard */}
      <p class="rail-keys" aria-hidden="true" title="↑ ↓ from floor to floor · Enter for details"><kbd>↑</kbd><kbd>↓</kbd></p>
    </nav>

    {/* The descent: eighteen islands down a shaft, stairwells between them. */}
    <section class="descent" id="atlas" aria-label="The World Dungeon">
      {/* tilt-shift: the top and bottom of the view go soft, so the floor in the middle is in focus */}
      <div class="tilt" aria-hidden="true">
        <div class="tilt-band tilt-top"><i></i><i></i><i></i></div>
        <div class="tilt-band tilt-bottom"><i></i><i></i><i></i></div>
      </div>
      <div class="dungeon" id="dungeon">
        <svg class="stairs" id="stairs" aria-hidden="true"></svg>
        <ol class="shaft" id="shaft">
          {atlas.map((t, i) => {
            const art = arts.get(t.id)!;
            const label = `Floor ${t.id}${t.name ? `, ${t.name}` : ''}${art.own ? '' : ', not yet pictured'}`;
            const isle = (
              <span class="art" data-cubes={art.cubes} data-origin={art.origin.join(',')} data-scale={art.scale}>
                <img class="isle-img" src={art.src} width={art.width} height={art.height}
                     style={`view-transition-name:floor-art-${t.id}`} alt={label} loading={Math.abs(t.id - (current ?? 1)) < 3 ? 'eager' : 'lazy'} decoding="async" />
                {art.stair && <span class="stairmark" style={`left:${art.stair[0] * 100}%;top:${art.stair[1] * 100}%`} />}
              </span>
            );
            return (
              <li id={`floor-${t.id}`} class={`level level-${t.kind}${t.current ? ' is-here' : ''}${peekId === t.id ? ' is-picked' : ''}${hudStart === t.id ? ' in-view' : ''}`}
                  data-id={t.id} data-side={i % 2 ? 'r' : 'l'} data-depart={art?.stair ? art.stair.join(',') : '0.5,0.93'}
                  data-lit={t.kind === 'reached' ? '1' : '0'} style={`--tile:${t.accent};--i:${i};--ar:${(art.width / art.height).toFixed(4)}`}>
                {t.href
                  ? <a class="isle" href={t.href} data-peek={t.id} aria-label={`${label}${t.current ? ', where you are' : ''}: details`}>{isle}{t.current && <span class="here-pin" aria-hidden="true"><b></b>You are here</span>}</a>
                  : <div class="isle" role="img" aria-label={`${label}, sealed`}>{isle}</div>}
              </li>
            );
          })}
        </ol>
        <div class="bottom" aria-hidden="true"><span class="label">The bottom</span></div>
      </div>
    </section>
  </div>
  </div>
  </>}
</Layout>

<script>
  /* The homepage is the crawl, and the crawl is a descent. All of it works on
     markup the server rendered; the script adds the motion and saves round trips.

     The sequence, all of it tied to the scroll and so all of it reversible:
     1. The floor on the focus line is whole and lit; the next one waits below,
        dark and soft in the tilt-shift; the floors above are gone.
     2. Scrolling down, a stairwell builds out of the floor step by step, down
        to the next one (its first steps already show at rest: the way down).
     3. The next floor clicks onto the focus line and is pinned there. The
        wheel and the keys step from floor to floor; scrolled freely (a finger,
        the scrollbar) a floor is held for a notch's worth and the page glides
        the last stretch when the reader stops.
     4. Behind, the floor that was left collapses, as floors do: it cracks,
        its underside and rim give first, its chunks sink, tip and fade into the
        dark with crumbs and dust, and its stairs crumble after it.
     5. Scrolling up rewinds it: the floor above comes back together.

     Beside it the System's box speaks of the floor on the focus line; a floor's
     card opens from the box and closes back into it, the page held still while
     it is open. Every pick is a real link, so with no JavaScript, a middle-click
     or a failed fetch it simply navigates. */
  const root = document.documentElement;
  const crawl = document.getElementById('crawl');
  const dungeon = document.getElementById('dungeon');
  const svg = document.getElementById('stairs') as SVGSVGElement | null;
  const hud = document.getElementById('hud');
  const card = document.getElementById('dcard');
  const text = document.getElementById('dcardtext');
  const artBox = document.getElementById('dcardart');
  const reveal = () => root.classList.remove('descent-pending');
  if (crawl && dungeon && svg && hud && card && text && artBox) {
    const motion = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const narrow = matchMedia('(max-width: 999px)');
    const EASE = 'cubic-bezier(.22, 1, .36, 1)';
    const levels = [...dungeon.querySelectorAll<HTMLElement>('.level')];
    const idOf = (el: Element) => Number((el as HTMLElement).dataset.id);
    const levelOf = (id: number) => levels.find(l => idOf(l) === id);
    const imgOf = (id: number) => levelOf(id)?.querySelector<HTMLImageElement>('.isle-img') ?? null;
    const cards = new Map([...hud.querySelectorAll<HTMLElement>('.hud-card')].map(c => [Number(c.dataset.floor), c]));
    const pickable = levels.filter(l => l.querySelector('[data-peek]')).map(idOf);
    const hudCards = document.getElementById('hudcards')!;
    const hudTitle = document.getElementById('hudtitle');
    const world = document.getElementById('world')!;
    const descentEl = dungeon.closest<HTMLElement>('.descent')!;
    const rail = document.getElementById('rail');
    // the pinned header: everything under it is the room the descent has
    const gateEl = document.getElementById('top');
    if (motion) dungeon.classList.add('moves');
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));

    /* ---- measured when the layout changes, read on every frame ---- */
    type Box = { left: number; top: number; width: number; height: number };
    const boxIn = (el: HTMLElement): Box => {
      let left = 0, top = 0, n: HTMLElement | null = el;
      while (n && n !== dungeon) { left += n.offsetLeft; top += n.offsetTop; n = n.offsetParent as HTMLElement | null; }
      return { left, top, width: el.offsetWidth, height: el.offsetHeight };
    };
    const centres = new Map<number, number>(), halves = new Map<number, number>();
    const cardHeights = new Map<number, number>();
    let dungeonTop = 0, descentTop = 0, worldMid = 0, boxH = 0, shown = Number([...cards.values()].find(c => c.classList.contains('is-shown'))?.dataset.floor ?? 0);
    const gateTop = () => gateEl?.offsetHeight ?? 0;

    /* ---- home: the title stands over the reader's own floor ----
       The page opens on the reader's floor, so that is its homepage: there the
       title stands full size over the box, the box under it, the floor beside
       them. Moving off toward the next floor (or the one above) it shrinks into
       a small title over the box, all of it tied to the scroll, and grows again
       on the way back. With nothing read, home is the top. On a phone the title
       is a band over the strip at home and slides away under the header
       elsewhere. The title is out of the flow once the script runs, so the box's
       place is worked out here and not by the layout. */
    const homeId = Number(levels.find(l => l.classList.contains('is-here'))?.dataset.id ?? 0);
    const titleIn = hudTitle?.querySelector<HTMLElement>('.hud-title-in') ?? null;
    const titleEye = titleIn?.querySelector<HTMLElement>('.eyebrow') ?? null;
    const K_SMALL = () => (narrow.matches ? 0 : 0.34), GAP = () => (narrow.matches ? 0 : 14);
    let titleH = 0, kBig = 1, homeY = 0, spanUp = 1, spanDown = 1;
    const cardFor = (id: number) => (pickable.length ? id : 0);
    // how much of home is in view at scroll y: 1 on it, 0 a little over halfway to the next stop either side
    const homeAt = (y: number) => { const d = y - homeY, span = d > 0 ? spanDown : spanUp; const t = clamp01(Math.abs(d) / (0.55 * span)); return 1 - t * t * (3 - 2 * t); };
    const kAt = (y: number) => { const h = homeAt(y), s = K_SMALL(); return motion ? s + (kBig - s) * h : h > 0.5 ? kBig : s; };

    function measure() {
      root.style.setProperty('--gate-h', `${gateTop()}px`);
      crawl!.classList.add('pinned-title');
      titleH = titleIn?.offsetHeight ?? 0;
      // every card's own height, so the box can grow and shrink to it smoothly
      for (const [id, c] of cards) { const was = c.style.display; c.style.display = 'block'; cardHeights.set(id, c.offsetHeight); c.style.display = was; }
      dungeonTop = dungeon!.getBoundingClientRect().top + scrollY;
      descentTop = descentEl.getBoundingClientRect().top + scrollY;
      const w = world.getBoundingClientRect(); worldMid = w.top + scrollY + w.height / 2;
      for (const lv of levels) { const b = boxIn(lv.querySelector<HTMLElement>('.art')!); centres.set(idOf(lv), dungeonTop + b.top + b.height / 2); halves.set(idOf(lv), b.height / 2); }
      sizeBox(shown, false);
      /* The title at home: full size. The box under it takes the room that is
         left, its text scrolling if the card is longer (a first visit's welcome
         is); only a view too short to leave the box a fair share shrinks the
         title, and on a phone the floor keeps at least 40% of the view. */
      const g = gateTop(), hHome = Math.min(boxHeightFor(cardFor(homeId)), 0.45 * (innerHeight - g));
      kBig = titleH ? Math.min(1, Math.max(K_SMALL(), narrow.matches ? (innerHeight * 0.6 - g - boxH) / titleH : (innerHeight - g - 32 - GAP() - hHome) / titleH)) : 0;
      const i = Math.max(0, levels.findIndex(l => idOf(l) === homeId));
      homeY = i > 0 ? restOn(homeId) : 0;
      const prev = i > 0 ? (i === 1 ? 0 : restOn(idOf(levels[i - 1]))) : null, next = levels[i + 1] ? restOn(idOf(levels[i + 1])) : null;
      spanUp = prev != null ? Math.max(120, homeY - prev) : 600;
      spanDown = next != null ? Math.max(120, next - homeY) : 600;
    }
    // the box is as tall as what it says, up to the room there is under the small title
    const capH = (h: number) => Math.min(h, innerHeight - gateTop() - 32 - K_SMALL() * titleH - GAP());
    const boxHeightFor = (id: number) => (narrow.matches ? boxH : capH(cardHeights.get(id) ?? boxH));
    // and with k of the title over it, no taller than the room left under the title
    const roomFor = (k: number, h: number) => (narrow.matches ? h : Math.min(h, innerHeight - gateTop() - 32 - k * titleH - GAP()));
    /* The box's height eases to its card's over .45s, here rather than in CSS,
       because its top is worked out from that height every frame. */
    let shownH = 0, fromH = 0, hT0 = -1;
    function sizeBox(id: number, smooth = true) {
      if (narrow.matches) { boxH = hudCards.offsetHeight; hudCards.style.height = ''; shownH = boxH; hT0 = -1; root.style.setProperty('--strip-h', `${boxH}px`); return; }
      root.style.setProperty('--strip-h', '0px');
      boxH = capH(cardHeights.get(id) ?? hudCards.offsetHeight);
      if (!smooth || !motion || !shownH) { shownH = boxH; hT0 = -1; } else { fromH = shownH; hT0 = performance.now(); }
      onScroll();
    }
    // the box at its size at once (to be flown into, or after a jump)
    function settleBox() { shownH = boxH; hT0 = -1; placeBox(scrollY); }

    /* ---- the focus line: the middle of the box ----
       The box is pinned with its middle on the middle of the view under the
       header, unless the title over it needs the room, and then it stands
       under the title. On a phone, the box is a console docked at the bottom
       of the screen and the focus line is the middle of the room between the
       header (and the title's band, at home) and the console. */
    function boxTopFor(k: number, h: number) {
      const g = gateTop(), t = k * titleH;
      return narrow.matches ? innerHeight - h : Math.max(g + 16 + t + GAP(), g + (innerHeight - g - h) / 2);
    }
    const focusFor = (k: number, h: number) => { const t = boxTopFor(k, h); return narrow.matches ? (gateTop() + k * titleH + t) / 2 : t + h / 2; };
    const focusAt = (y: number, h = boxH) => { const k = kAt(y); return focusFor(k, roomFor(k, h)); };
    const focusNow = () => focusAt(scrollY);
    // the box, the title over it and the room under them, drawn for scroll y
    let lastUnder = -1;
    function placeBox(y: number) {
      const k = kAt(y), g = gateTop();
      if (hT0 >= 0) { const p = clamp01((performance.now() - hT0) / 450); shownH = fromH + (boxH - fromH) * (1 - (1 - p) ** 4); if (p >= 1) hT0 = -1; }
      const h = roomFor(k, narrow.matches ? boxH : shownH), top = boxTopFor(k, h);
      if (!narrow.matches) hudCards.style.height = `${h}px`;
      // on a phone the console is docked at the bottom by the stylesheet
      hudCards.style.top = narrow.matches ? '' : `${top}px`;
      if (hudTitle && titleIn) {
        if (narrow.matches) { hudTitle.style.top = `${g - titleH + k * titleH}px`; titleIn.style.transform = ''; }
        else { hudTitle.style.top = `${top - GAP() - k * titleH}px`; titleIn.style.transform = `scale(${k.toFixed(4)})`; }
        // the eyebrow is too small to read once the title has shrunk: it goes first
        if (titleEye) titleEye.style.opacity = String(narrow.matches ? 1 : clamp01((k - K_SMALL()) / Math.max(0.01, kBig - K_SMALL())));
      }
      // on a phone, the room between the title's band and the console is where the tilt-shift works
      const under = Math.round(k * titleH);
