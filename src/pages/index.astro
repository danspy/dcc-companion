        vec3 p = place(pos);
        gl_Position = vec4(p.x / uCanvas.x * 2.0 - 1.0, 1.0 - p.y / uCanvas.y * 2.0, 2.0 * p.z - 1.0, 1.0);
        int flags = int(aColor.a * 255.0 + 0.5);
        float k = aFace < 0.5 ? 1.12 : aFace < 1.5 ? 0.86 : aFace < 2.5 ? 0.64 : aFace < 3.5 ? 0.42 : aFace < 4.5 ? 0.72 : 0.56;
        if ((flags & 2) != 0) k = 1.0; else if ((flags & 1) != 0) k = max(k, 1.0);
