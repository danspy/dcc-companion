    /* One cube per instance, drawn twice: once at rest into an id buffer (which
       chunk and how deep, per pixel of the picture), then every frame where it
       is. A cube still in place is not drawn: the picture is. A cube's visible
       faces are coloured from the picture at its place of rest, the faces it
       turns to show from its own tone. */
    const VS_CUBE = `#version 300 es
      layout(location=0) in vec3 aCorner; layout(location=1) in vec2 aUV; layout(location=2) in float aFace;
      layout(location=3) in vec3 aHome; layout(location=4) in vec4 aPivot; layout(location=5) in vec4 aSpin; layout(location=6) in vec4 aDrift; layout(location=7) in vec4 aColor;
      uniform float uQ, uS, uLead, uDur, uRest; uniform vec2 uOrigin, uCanvas, uDepth;
      out vec3 vFlat; out vec2 vUV; out vec2 vRest; out float vRestZ; out float vA; out float vDark; flat out float vFace; flat out float vCode;
      vec3 turn(vec3 v, vec3 k, float a) { return v * cos(a) + cross(k, v) * sin(a) + k * dot(k, v) * (1.0 - cos(a)); }
      vec3 place(vec3 p) {
        return vec3((p.x - p.y) * 4.0 * uS + uOrigin.x, ((p.x + p.y) * 2.0 - p.z * 4.0) * uS + uOrigin.y,
                    1.0 - clamp((p.x + p.y + p.z - uDepth.x) / (uDepth.y - uDepth.x), 0.0, 1.0));
