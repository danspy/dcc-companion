    }
    // room above the first floor so it sits on the focus line at the very top, beside its own card
    function lead() {
      const first = levels[0];
      if (!first || !centres.has(idOf(first))) return;
      const h = boxHeightFor(cardFor(idOf(first)));
      const cur = parseFloat(getComputedStyle(dungeon!).paddingTop) || 0;
      const next = Math.max(8, Math.round(cur + focusAt(0, h) - centres.get(idOf(first))!));
      if (Math.abs(next - cur) > 1) { dungeon!.style.paddingTop = `${next}px`; measure(); }
    }

    /* ---- the pin ----
       A floor coming onto the focus line catches up with it and clicks into
       place: for a moment a little faster than the page, then not at all. It
       sits there, pinned, for a short stretch of scrolling (PIN either side of
       the line) and leaves the same way. Its drawn distance from the line is 0
       inside the pin and its laid-out distance beyond PIN + LEAP; in between, a
       Hermite curve that starts at rest and ends at the page's own speed, so
       nothing jumps. The layout's --dwell leaves the room the pin uses. */
    const PIN = () => (narrow.matches ? 64 : 100), LEAP = () => (narrow.matches ? 96 : 130);
    function holdOffset(d: number) {
      if (!motion) return 0;
      const h = PIN(), w = LEAP(), a = Math.abs(d);
      if (a >= h + w) return 0;
      if (a <= h) return -d;
      const t = (a - h) / w, f = (3 * t * t - 2 * t * t * t) * (h + w) + (t * t * t - t * t) * w;
      return Math.sign(d) * f - d;
    }
    const dOf = (id: number, focusDoc: number) => (centres.get(id) ?? 0) - focusDoc;
    /* Where the view is between floor a and the next: 0 on a, 1 on the next. */
    const between = (i: number, focusDoc: number) => {
      const a = centres.get(idOf(levels[i])) ?? 0, b = levels[i + 1] ? centres.get(idOf(levels[i + 1]))! : a + 1;
      return (focusDoc - a) / Math.max(1, b - a);
    };

    /* ---- stairwells: steps of voxels, built one by one, crumbling behind ---- */
    const shade = (hex: string, k: number) => {
      const n = parseInt(hex.replace('#', '').trim().slice(0, 6), 16);
      const c = (v: number) => Math.max(0, Math.min(255, Math.round(v * k))).toString(16).padStart(2, '0');
      return `#${c((n >> 16) & 255)}${c((n >> 8) & 255)}${c(n & 255)}`;
    };
    type Flight = { steps: SVGGElement[]; t: number[]; on: number; fall: number; top: number; bottom: number };
    let flights: Flight[] = [];
    function drawStairs() {
      svg!.setAttribute('viewBox', `0 0 ${dungeon!.offsetWidth} ${dungeon!.offsetHeight}`);
      const out: string[] = ['<defs><radialGradient id="torchglow"><stop offset="0" stop-color="#ffb340" stop-opacity=".55"/><stop offset="1" stop-color="#ff7a1f" stop-opacity="0"/></radialGradient></defs>'];
      const poly = (pts: number[][], fill: string) => `<polygon points="${pts.map(q => q.map(v => v.toFixed(1)).join(',')).join(' ')}" fill="${fill}" stroke="#120c0c" stroke-width="1" stroke-linejoin="round"/>`;
      const at = (r: Box, fx: number, fy: number) => [r.left + r.width * fx, r.top + r.height * fy];
      const boxOf = (lv: HTMLElement) => boxIn(lv.querySelector<HTMLElement>('.art')!);
      const tile = (lv: HTMLElement) => getComputedStyle(lv).getPropertyValue('--tile').trim() || '#ffc10a';
      const spans: { top: number; bottom: number; t: number[] }[] = [];
      levels.forEach((lv, i) => {
        const next = levels[i + 1];
        if (!next) return;
        const [fx, fy] = (lv.dataset.depart ?? '0.5,0.93').split(',').map(Number);
        const a = at(boxOf(lv), fx, fy), b = at(boxOf(next), 0.5, 0.14), lit = lv.dataset.lit === '1' && next.dataset.lit === '1', color = tile(lv);
        const dy = Math.max(30, (b[1] - a[1]) * 0.55);
        const P = (t: number) => { const u = 1 - t; return [u * u * u * a[0] + 3 * u * u * t * a[0] + 3 * u * t * t * b[0] + t * t * t * b[0], u * u * u * a[1] + 3 * u * u * t * (a[1] + dy) + 3 * u * t * t * (b[1] - dy) + t * t * t * b[1]]; };
        const pts: number[][] = [P(0)], ts = [0]; let prev = pts[0], acc = 0;
        for (let k = 1; k <= 400; k++) { const q = P(k / 400); acc += Math.hypot(q[0] - prev[0], q[1] - prev[1]); prev = q; if (acc >= 19) { pts.push(q); ts.push(k / 400); acc = 0; } }
        const stone = lit ? '#8a8a90' : '#4a4744', w = lit ? 13 : 9, h = lit ? 9 : 5, g: string[] = [], keep: number[] = [];
        pts.forEach(([x, y], k) => {
          if (!lit && k % 3 === 2) return;                       // gaps in the rubble
          const X = x + (lit ? 0 : ((k * 37) % 5) - 2), parts = [
            poly([[X, y - w / 2], [X + w, y], [X, y + w / 2], [X - w, y]], lit ? color : stone),
            poly([[X - w, y], [X, y + w / 2], [X, y + w / 2 + h], [X - w, y + h]], shade(stone, .86)),
            poly([[X, y + w / 2], [X + w, y], [X + w, y + h], [X, y + w / 2 + h]], shade(stone, .64)),
