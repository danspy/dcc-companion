---
import '../styles/global.css';
import GateBar from '../components/GateBar.astro';
import { readPrefs } from '../lib/prefs';
import { getBooks } from '../lib/content';

interface Props { title: string; description?: string }
const { title, description = 'A spoiler-gated companion to Dungeon Crawler Carl.' } = Astro.props;

const prefs = readPrefs(Astro.cookies);
const books = await getBooks();

const nav = [
  { href: '/', label: 'Floors' },
  { href: '/who', label: 'Who & What' },
  { href: '/when', label: 'Timeline' },
  { href: '/progress', label: 'Progress' },
  { href: '/achievement', label: 'Achievements' },
];
const here = Astro.url.pathname;
/* The section a page belongs to: its own entry, or the one it lives under. A
   floor's page (and a floor ahead) is part of Floors, an entry's page part of
   Who & What, which lists them. The section is marked in the header on every
   page under it, not only on its own, and named on the narrow screen's menu. */
const PARENTS: [RegExp, string][] = [[/^\/floor(\/|$)/, '/'], [/^\/entity(\/|$)/, '/who']];
const sectionHref = PARENTS.find(([re]) => re.test(here))?.[1] ?? nav.find(n => n.href !== '/' && (here === n.href || here.startsWith(`${n.href}/`)))?.href ?? (here === '/' ? '/' : null);
const section = nav.find(n => n.href === sectionHref);
// aria-current: "page" on the page itself, "true" on the section a subpage lives under
const current = (href: string) => (here === href ? 'page' : href === sectionHref ? 'true' : undefined);
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <title>{title} · Crawler's Companion</title>
  <script is:inline>
    /* the viewport's width, so a page can leave out what a narrow screen would only hide (/when's chart) */
    try { document.cookie = 'dcc_vw=' + Math.round(innerWidth) + '; path=/; max-age=31536000; samesite=lax'; } catch (e) {}
  </script>
  <script is:inline>
    /* Moving between pages, a floor's picture and name travel between the
       homepage and the floor's own page (global.css). Only a pair both pages
       really show may travel: every element that keeps a name and has no
       partner becomes a piece of its own that ignores the page's sink and rise
       (the homepage names all eighteen islands, most of them off screen or
       collapsed), which is what made the map's transition go wrong now and
       then. So leaving a page keeps only the names the next page shares, and
       only if they are on screen, and tells the next page which; it drops any
       name not on that list. A homepage freshly loaded rises like every page
       (the new page is shown live, so its floors appear as the script places
       them), but has not put the reader's floor in view yet when its first
       frame is taken, so none of its floors pairs. The header has a layer of
       its own that never animates (global.css). Names taken away are put back
       afterwards, and when the page is shown again from the back-forward cache. */
    (function () {
      var KEY = 'dcc-vt';
      var floorOf = function (u) { var m = /^\/floor\/(\d+)\/?$/.exec(u.pathname); return m ? m[1] : null; };
      var named = function () { return document.querySelectorAll('[style*="view-transition-name"]'); };
      var shows = function (el) {
        var r = el.getBoundingClientRect();
        if (!r.width || r.bottom <= 0 || r.top >= innerHeight) return false;
        return el.checkVisibility ? el.checkVisibility({ opacityProperty: true, visibilityProperty: true }) : true;
      };
      addEventListener('pageswap', function (e) {
        if (!e.viewTransition) return;
        var to = e.activation && e.activation.entry && e.activation.entry.url ? new URL(e.activation.entry.url) : null;
        var n = !to || to.origin !== location.origin ? null : location.pathname === '/' ? floorOf(to) : to.pathname === '/' ? floorOf(location) : null;
        var pair = n ? ['floor-art-' + n, 'floor-name-' + n] : [], kept = [];
        named().forEach(function (el) {
          var name = el.style.viewTransitionName;
          if (!name || name === 'none') return;
          if (pair.indexOf(name) >= 0 && shows(el)) kept.push(name);
          else { el.dataset.vtName = name; el.style.viewTransitionName = 'none'; }
        });
        try { sessionStorage.setItem(KEY, JSON.stringify(kept)); } catch (err) { /* then nothing pairs */ }
      });
      addEventListener('pagereveal', function (e) {
        document.querySelectorAll('[data-vt-name]').forEach(function (el) { el.style.viewTransitionName = el.dataset.vtName; delete el.dataset.vtName; });
        var kept = [];
        try { kept = JSON.parse(sessionStorage.getItem(KEY) || '[]'); sessionStorage.removeItem(KEY); } catch (err) { /* nothing pairs */ }
        if (!e.viewTransition) return;
        // a homepage that has not placed the reader's floor yet still rises like any page; only its floors do not pair
        var unplaced = location.pathname === '/' && !window.__descentPlaced;
        named().forEach(function (el) {
          var name = el.style.viewTransitionName;
          if (name && name !== 'none' && (unplaced || kept.indexOf(name) < 0 || !shows(el))) { el.dataset.vtName = name; el.style.viewTransitionName = 'none'; }
        });
        // and once it is over, every name is back for the next time
        e.viewTransition.finished.finally(function () { document.querySelectorAll('[data-vt-name]').forEach(function (el) { el.style.viewTransitionName = el.dataset.vtName; delete el.dataset.vtName; }); });
      });
    })();
  </script>
</head>
<body>
  {/* One header on every page, pinned: home, the sections, search and the
      reader's position in a single row, the position's panel opening under it.
      The masthead used to scroll away under a pinned bar of its own, and the
      homepage opens on the reader's floor, so a reader on floor 11 saw no way to
      another page and no name for the one they were on. On a narrow screen the
      sections fold into a menu that names the section the reader is in. */}
  <header class="top" id="top">
    <div class="wrap top-row">
      <a href="/" class="brand" aria-label="Crawler's Companion: the crawl so far">
        <span class="brand-mark">DCC</span>
      </a>
      <nav class="navlinks" aria-label="Sections">
        {nav.map(n => (
          <a href={n.href} class="navlink" aria-current={current(n.href)}>{n.label}</a>
        ))}
      </nav>
      <details class="menu">
        <summary class="menu-btn" aria-label={`Sections${section ? `, now ${section.label}` : ''}`}>
          <span>{section?.label ?? 'Menu'}</span>
          <svg class="menu-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg>
          <svg class="menu-icon" viewBox="0 0 14 12" aria-hidden="true"><path d="M1 2h12M1 6h12M1 10h12" /></svg>
        </summary>
        <nav class="menu-list wrap" aria-label="Sections">
          {nav.map(n => (
            <a href={n.href} class="navlink" aria-current={current(n.href)}>{n.label}</a>
          ))}
        </nav>
      </details>
      <span class="top-gap"></span>
      <!-- Without JavaScript this is a link to /who, which filters the same set. -->
      <a href="/who" class="findbtn" id="findbtn" aria-haspopup="dialog" aria-label="Search the record">
        <svg class="findbtn-glass" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" /><path d="M11 11l3.5 3.5" /></svg>
        <span class="findbtn-text">Search</span><kbd>Ctrl K</kbd>
      </a>
      <GateBar prefs={prefs} books={books} part="chip" />
    </div>
    <GateBar prefs={prefs} books={books} part="panel" />
  </header>

  <dialog id="quickfind" class="qf" aria-label="Search the record">
    <form method="dialog" class="qf-bar" role="search">
      <span class="qf-prompt" aria-hidden="true">›</span>
      <input id="qf-input" type="search" autocomplete="off" spellcheck="false"
             placeholder="Carl, Donut, a nickname, a floor…" aria-controls="qf-results"
             aria-describedby="qf-note" />
      <button class="qf-close" value="close" aria-label="Close search"><kbd>Esc</kbd></button>
    </form>
    <div id="qf-results" class="qf-results" role="listbox" aria-label="Results"></div>
    <p id="qf-note" class="qf-note"></p>
  </dialog>

  <main><slot /></main>

  <footer>
    <div class="wrap">
      <p>An unofficial reader's companion to Matt Dinniman's <strong>Dungeon Crawler Carl</strong>.
         Content is curated by hand and gated on reading position — set yours in the bar above.</p>
      <p class="muted">Palette and typefaces follow the official site: Barlow Condensed,
         Inconsolata and Open Sans on #131313.</p>
    </div>
  </footer>

  <script>
    /* Quick-find. Every answer comes from /find.json, which gates on the
       reader's own cookie; nothing searchable is held in the page. Rows are
       built with DOM nodes and textContent, never innerHTML, so their styles
       live in the global component layer: a scoped rule cannot reach markup a
       script built. */
    type Hit = { href: string; name: string; kind: string; detail: string; tier: 'name' | 'story' | 'recent' };
    const dlg = document.getElementById('quickfind') as HTMLDialogElement;
    const input = document.getElementById('qf-input') as HTMLInputElement;
    const box = document.getElementById('qf-results') as HTMLDivElement;
    const note = document.getElementById('qf-note') as HTMLParagraphElement;
    const btn = document.getElementById('findbtn') as HTMLAnchorElement;
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform);
    btn.querySelector('kbd')!.textContent = isMac ? '⌘K' : 'Ctrl K';

    let active = -1, timer = 0, seq = 0;
    let hits: Hit[] = [];
    let rows: HTMLAnchorElement[] = [];

    const IDLE = 'Only what you have already reached answers. Arrows choose, Enter opens.';

    /* The typed words, lit where they start a word, so a story hit shows why. */
    function lit(text: string, q: string): Node[] {
      const words = q.toLowerCase().split(/[^a-z0-9']+/).filter(Boolean)
        .map(w => w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
      if (!words.length) return [document.createTextNode(text)];
      const re = new RegExp(`\\b(${words.join('|')})[a-z0-9']*`, 'gi');
      const out: Node[] = []; let last = 0;
      for (const m of text.matchAll(re)) {
        if (m.index! > last) out.push(document.createTextNode(text.slice(last, m.index)));
        const mark = document.createElement('mark'); mark.textContent = m[0]; out.push(mark);
        last = m.index! + m[0].length;
      }
      if (last < text.length) out.push(document.createTextNode(text.slice(last)));
      return out;
    }

    function group(title: string, list: Hit[], q: string, start: number) {
      const sec = document.createElement('section'); sec.className = 'qf-group';
      const h = document.createElement('h2'); h.className = 'qf-group-title'; h.textContent = title;
      sec.append(h);
      list.forEach((hit, j) => {
        const a = document.createElement('a');
        a.href = hit.href; a.className = 'qf-row'; a.id = `qf-${start + j}`;
        a.setAttribute('role', 'option');
        const name = document.createElement('span'); name.className = 'qf-name';
        name.append(...lit(hit.name, q));
        const kind = document.createElement('span'); kind.className = 'qf-kind'; kind.textContent = hit.kind;
        const detail = document.createElement('span'); detail.className = 'qf-detail';
        detail.append(...lit(hit.detail, q));
        a.append(name, kind, detail);
        // Close before leaving: a hit on the page already open only changes the hash.
        a.addEventListener('click', () => dlg.close());
        a.addEventListener('mousemove', () => { if (active !== start + j) { active = start + j; mark(false); } });
        sec.append(a); rows.push(a);
      });
      return sec;
    }

    /* Recent: the last pages opened, kept as addresses only and named by the server. */
    const RECENT = 'dcc-recent';
    const recentPaths = (): string[] => { try { return JSON.parse(localStorage.getItem(RECENT) || '[]'); } catch { return []; } };
    if (/^\/(entity\/[a-z0-9-]+|floor\/\d+)$/.test(location.pathname)) {
      try { localStorage.setItem(RECENT, JSON.stringify([location.pathname, ...recentPaths().filter(p => p !== location.pathname)].slice(0, 8))); } catch { /* fine without it */ }
    }
    let recent: Hit[] = [];
    async function loadRecent() {
      const paths = recentPaths().filter(p => p !== location.pathname);
      if (!paths.length) { recent = []; return; }
      try { recent = await (await fetch(`/find.json?recent=${encodeURIComponent(paths.join(','))}`, { credentials: 'same-origin' })).json(); } catch { recent = []; }
    }

    function render(h: Hit[]) {
      const q = input.value.trim();
      if (!q && recent.length) {
        rows = []; hits = recent; active = -1;
        box.replaceChildren(group('Recent', recent, '', 0));
        dlg.dataset.state = 'hits'; note.textContent = IDLE; mark(false);
        return;
      }
      hits = [...h.filter(x => x.tier === 'name'), ...h.filter(x => x.tier === 'story')];
      rows = []; active = hits.length ? 0 : -1;
      const named = hits.filter(x => x.tier === 'name');
      const story = hits.filter(x => x.tier === 'story');
      const parts: Node[] = [];
      if (named.length) parts.push(group('Names', named, q, 0));
      if (story.length) parts.push(group('In the story', story, q, named.length));
      if (q && !hits.length) {
        const none = document.createElement('p'); none.className = 'sys qf-none';
        const b = document.createElement('b'); b.textContent = '*** No record ***';
        none.append(b, document.createTextNode('Nothing you have reached answers to that. Try a shorter word, or a nickname.'));
        parts.push(none);
      }
      box.replaceChildren(...parts);
      dlg.dataset.state = !q ? 'idle' : hits.length ? 'hits' : 'none';
      note.textContent = IDLE;
      mark(false);
    }

    function mark(scroll = true) {
      rows.forEach((r, i) => r.setAttribute('aria-selected', String(i === active)));
      input.setAttribute('aria-activedescendant', active >= 0 ? `qf-${active}` : '');
      if (scroll) rows[active]?.scrollIntoView({ block: 'nearest' });
    }

    async function search() {
      const q = input.value.trim(), mine = ++seq;
      if (!q) { render([]); return; }
      try {
        const res = await fetch(`/find.json?q=${encodeURIComponent(q)}`, { credentials: 'same-origin' });
        const h = await res.json();
        if (mine === seq) render(h);
      } catch { /* a failed lookup keeps the last results; the box still works */ }
    }

    function open() {
      if (dlg.open) return;
      dlg.showModal(); input.value = ''; render([]); input.focus();
      loadRecent().then(() => { if (dlg.open && !input.value.trim()) render([]); });
    }

    btn.addEventListener('click', e => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault(); open();
    });
    input.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(search, 90); });
    input.addEventListener('keydown', e => {
      if (e.key === 'ArrowDown' && hits.length) { e.preventDefault(); active = (active + 1) % hits.length; mark(); }
      else if (e.key === 'ArrowUp' && hits.length) { e.preventDefault(); active = (active - 1 + hits.length) % hits.length; mark(); }
      else if (e.key === 'Enter') { e.preventDefault(); if (hits[active]) { dlg.close(); location.href = hits[active].href; } }
    });
    // A click on the backdrop closes it, as a click outside any overlay should.
    dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
    document.addEventListener('keydown', e => {
      const typing = e.target instanceof HTMLElement && e.target.closest('input, textarea, select, [contenteditable]');
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open(); return; }
      // "/" belongs to a page's own filter where it has one (/who, /when, /achievement).
      if (e.key === '/' && !typing && !document.querySelector('main .finder-search input')) { e.preventDefault(); open(); }
    });
  </script>
</body>
</html>

<style>
  .top { position: sticky; top: 0; z-index: 50; background: #0b0b0bf2;
         backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-line); }
  .top-row { display: flex; align-items: center; gap: 14px; min-height: 56px; }
  .brand { display: flex; align-items: center; color: inherit; text-decoration: none; flex: none; }
  .brand:hover { text-decoration: none; }
  .brand:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 3px; }
  .brand-mark { font-family: var(--font-display); font-weight: 800; font-size: 22px; line-height: 1.25;
                letter-spacing: .02em; color: #0e0e0e; background: var(--color-gold); padding: 1px 8px 0; }
  /* One row, never wrapped: wrapping once left "Position" orphaned on a second
     line, which reads as a mistake rather than a menu. */
  .navlinks { display: flex; gap: 2px; flex-wrap: nowrap; min-width: 0; }
  .navlink { font-family: var(--font-mono); font-size: var(--type-ui);
             letter-spacing: var(--ls-label); flex: none; white-space: nowrap;
             text-transform: uppercase; color: var(--color-grey-300);
             border: 1px solid transparent; padding: 6px 9px; }
  .navlink:hover { color: var(--color-grey-100); border-color: var(--color-line); text-decoration: none; }
  .navlink[aria-current] { color: var(--color-gold); border-color: var(--color-line); }
  .top-gap { flex: 1 1 auto; }
  /* search, in the header: the glass, a word and the key, never a wide field */
  .top .findbtn { flex: none; margin: 0; gap: 8px; }
  /* the menu is for a narrow screen; it drops a panel the width of the header */
  .menu { display: none; }
  .menu-btn { display: inline-flex; align-items: center; gap: 8px; height: 34px; padding: 0 10px; cursor: pointer;
              list-style: none; border: 1px solid var(--color-line); font-family: var(--font-mono); font-size: var(--type-ui);
              letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--color-gold); white-space: nowrap; }
  .menu-btn::-webkit-details-marker { display: none; }
  .menu-btn:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 2px; }
  .menu-btn svg { width: 10px; height: 6px; fill: none; stroke: currentColor; stroke-width: 1.6; transition: rotate .2s; }
  .menu[open] .menu-caret { rotate: 180deg; }
  .menu-icon { display: none; }
  .menu-list { position: absolute; left: 0; right: 0; top: 100%; display: flex; flex-direction: column; gap: 2px;
               padding-block: 10px 14px; background: var(--color-panel); border-top: 3px solid var(--color-gold);
               border-bottom: 1px solid var(--color-line); box-shadow: 0 18px 40px #000a; }
  .menu-list .navlink { padding: 11px 10px; font-size: var(--type-ui); }
  @media (max-width: 980px) {
    .navlinks { display: none; }
    .menu { display: block; }
    .top-row { gap: 8px; min-height: 52px; }
    .top .findbtn-text, .top .findbtn kbd { display: none; }
    .top .findbtn { width: 34px; height: 34px; justify-content: center; padding: 0; }
    /* the section's name gives way before anything else does */
    .menu { flex: 0 1 auto; min-width: 0; }
    .menu-btn { display: flex; min-width: 0; max-width: 100%; }
    .menu-btn span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  }
  @media (max-width: 420px) {
    .top .top-row { padding-inline: 14px; gap: 6px; }
    .menu-btn { padding: 0 8px; gap: 6px; }
    .brand-mark { font-size: 19px; padding: 1px 6px 0; }
  }
  /* too narrow to name the section without cutting it: the menu is an icon */
  @media (max-width: 360px) {
    .menu-btn span, .menu-caret { display: none; }
    .menu-btn .menu-icon { display: block; width: 14px; height: 12px; }
  }
  footer { border-top: 1px solid var(--color-line); margin-top: 48px; padding: 32px 0 64px;
           font-size: 13.5px; color: var(--color-grey-500); }
  footer p { max-width: var(--measure); margin: 0 0 10px; }
  footer strong { color: var(--color-grey-200); }
  .muted { color: var(--color-grey-700); }
</style>
