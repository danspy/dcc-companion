{
  "name": "dcc-companion",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_DATABASE_FILE=./data/dcc.db astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "content:build": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check && node scripts/check-pages.mjs && node scripts/check-stage.mjs",
    "test:gate": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test scripts/test-gate.mjs",
    "chapters:refresh": "node scripts/fetch-chapters.mjs",
    "content:coverage": "node scripts/coverage-report.mjs",
    "check": "astro check",
    "colors:refresh": "node scripts/fetch-book-colors.mjs",
    "content:anchors": "node scripts/check-anchors.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@astrojs/db": "^0.20.0",
    "@astrojs/node": "^10.0.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inconsolata": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-basic-ssl": "^2.2.0",
    "astro": "^6.0.4",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "vite": "^7"
  }
}
